# ─────────────────────────────────────────────────────────────────────────────
# Keos SRE Agent — environment template
# ─────────────────────────────────────────────────────────────────────────────
#
# How to use this file:
#
#   1. Copy to `.env` for laptop development:
#        cp .env.example .env       (macOS/Linux)
#        Copy-Item .env.example .env   (PowerShell)
#
#   2. `make install` (or `.\make.ps1 install`) generates `.env.local` with a
#      random `SHP_API_TOKEN`. Do NOT copy this template over `.env.local` —
#      that file holds your bearer token. The two are merged at runtime
#      (`.env` first, then `.env.local` overrides).
#
#   3. For production (Helm-installed in a cluster), set values via
#      `--set` flags or a `values.yaml` overlay — not via this file. See
#      `deploy/helm/pocteo/values.yaml`.
#
# Every variable below is OPTIONAL — defaults are wired into `agent/config.py`
# and the cluster Helm chart. Setting a variable here overrides the default.
# Sections are ordered from "most likely to override" to "almost never touch".
# ─────────────────────────────────────────────────────────────────────────────


# ── Auth (REQUIRED for the Web UI) ──────────────────────────────────────────
# Bearer token the SPA pastes into the login screen. Auto-generated by
# `make up` / `make install` into `.env.local` (NOT this file). If you ever
# want a stable token you control, paste it into `.env.local` instead.
#
# Constant-time-compared; rotate any time by editing `.env.local` and
# restarting the api container. See docs/RUNBOOKS/secret-rotation.md.
#SHP_API_TOKEN=replace-with-32-bytes-of-entropy-or-let-make-up-generate

# Production-only: when the token comes from a Kubernetes `Secret` projected
# volume, point this at the mounted file path. The api re-reads on every
# request so `kubectl edit secret` propagates without restart (~60 s).
# Mutually exclusive with `SHP_API_TOKEN`.
#SHP_API_TOKEN_FILE=/var/run/secrets/keos/api-token

# HMAC key for the tamper-evident audit chain. DEV ONLY — anyone with this
# key can forge audit entries. Rotate before any non-laptop deployment.
# 32+ bytes of entropy recommended. See docs/RUNBOOKS/secret-rotation.md.
AUDIT_HMAC_KEY=dev-key-replace-me-with-32-bytes-of-entropy


# ── Service endpoints ───────────────────────────────────────────────────────
# Off-cluster stack reachable from the api process. Defaults assume
# docker-compose on the local host. Override only if you're running the
# agent in-cluster (Helm chart wires these via Service DNS).
OLLAMA_HOST=http://localhost:11434
QDRANT_URL=http://localhost:6333
NATS_URL=nats://localhost:4222
OPA_URL=http://localhost:8181
K8SGPT_URL=http://localhost:8089/mcp
MCP_URL=http://localhost:8090/mcp


# ── LLM models ──────────────────────────────────────────────────────────────
# Must match what `make pull-models` downloaded. The 7b q4_K_M chat model
# is ~4.4 GB resident — fits in ≥ 8 GB VRAM or in ~6 GB system RAM.
# Switch to qwen2.5:3b-instruct-q4_K_M (~1.9 GB) on < 8 GB cards or CPU
# hosts where the larger model is too slow.
# Embed model is ~270 MB; used by seed_rag + retrieve_context.
OLLAMA_CHAT_MODEL=qwen2.5:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text


# ── Kubernetes ──────────────────────────────────────────────────────────────
# Kubeconfig the agent uses to talk to the cluster. `make cluster` creates
# `./.kube/config` pointing at the local k3d cluster. For Helm-installed
# clusters, the in-pod ServiceAccount is auto-detected.
KUBECONFIG=./.kube/config

# Identity of the cluster-scoped `AgentMode` CR that holds the kill-switch
# (observe-only | active | frozen). Only override if you renamed the CR.
AGENT_MODE_NAME=default

# Comma-separated namespaces the chaos observer watches for kubelet events.
# Empty/unset → all namespaces except kube-system / kube-public / kube-node-lease.
#WATCH_NAMESPACES=workloads,prod


# ── Agent behavior ──────────────────────────────────────────────────────────
# Below this LLM confidence score, the graph escalates instead of acting.
# Tighten (0.7-0.8) for stricter operations; loosen (0.4-0.5) for aggressive
# auto-healing in a dev cluster.
AGENT_CONFIDENCE_THRESHOLD=0.6

# Discard infrastructure events older than this many seconds at the triage
# step. Prevents the agent from re-acting on already-healed events that
# were queued behind a slow LLM run.
STALE_EVENT_S=600

# When set, `execute` bypasses the MCP server and calls `agent/tools.py`
# directly. Hermetic-test only — do NOT set in production; the MCP path
# applies a second OPA check (defense in depth).
#MCP_BYPASS=


# ── HTTP server (api) ───────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated origins allowed for CORS. Unset → localhost only.
# Set to your operator-facing domain when serving the SPA from elsewhere.
#KEOS_ALLOWED_ORIGINS=https://keos.example.com,https://ops.example.com

# Per-IP rate limit (limits library syntax). Probe + /metrics paths are
# exempt. Drop to "30/minute" for paranoid prod; raise for soak testing.
KEOS_RATE_LIMIT_GLOBAL=120/minute


# ── Observability ───────────────────────────────────────────────────────────
# Log format: `text` (human-readable, default for `make demo`) or
# `json` (one record per line, parseable by Loki/Datadog/jq).
LOG_FORMAT=text
LOG_LEVEL=INFO


# ── Data retention ──────────────────────────────────────────────────────────
# How long to keep on-disk artifacts before the background sweeper prunes
# them. Audit log uses daily rotation; verifier walks all siblings so the
# HMAC chain stays verifiable across rotation.
AUDIT_LOG_RETENTION_DAYS=30
INCIDENT_RETENTION_DAYS=90
TRACE_RETENTION_DAYS=30
RETENTION_SWEEP_INTERVAL_S=3600

# Where the audit log lives. The directory is created on first write.
AUDIT_LOG_PATH=./agent/audit.log

# Qdrant collection name for runbook embeddings.
QDRANT_COLLECTION=runbooks


# ── Notifications (all optional) ────────────────────────────────────────────
# When `page_human` action runs, the agent POSTs to whichever of these is
# set. Both can be set simultaneously; both get delivered.
#
# Get a Slack webhook from: Slack admin → Apps → Incoming Webhooks.
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T0/B0/XYZ

# Generic webhook (any service accepting a JSON POST: PagerDuty, Opsgenie,
# Discord, Teams, a custom collector).
#PAGE_HUMAN_WEBHOOK_URL=https://example.com/webhooks/keos


# ── Inbound webhooks (alertmanager bridge) ──────────────────────────────────
# Bearer token Alertmanager must send when POSTing to
# /api/webhooks/alertmanager. Fail-closed: missing/unset = 503.
# Generate with: openssl rand -hex 32.
#ALERTMANAGER_WEBHOOK_TOKEN=replace-with-32-bytes-hex


# ── Branding (display only) ─────────────────────────────────────────────────
# Product name shown in the FastAPI OpenAPI doc + SPA title.
POCTEO_PRODUCT_NAME=Keos SRE Agent

# Base URL the `demo_ui.py` CLI hits for the orchestrated demo. Only
# override if you're behind a different reverse proxy than Caddy:80.
#SHP_DEMO_BASE=http://localhost
