# Slim FastAPI runtime image for the self-healing agent's API + serve loop.
# Mirrors mcp_server/Dockerfile: python:3.12-slim + tini + kubectl + uv.

FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends curl ca-certificates tini \
 && rm -rf /var/lib/apt/lists/* \
 && KUBECTL_VERSION="v1.31.5" \
 && curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl" \
 && chmod +x /usr/local/bin/kubectl \
 && pip install --no-cache-dir --upgrade uv

WORKDIR /app

# Project metadata + source. The uv resolution runs on linux inside the
# container — we don't reuse uv.lock from the Windows host.
COPY pyproject.toml /app/
COPY agent /app/agent
COPY mcp_server /app/mcp_server

RUN uv pip install --system --no-cache .

ENV PYTHONUNBUFFERED=1 \
    KUBECONFIG=/root/.kube/config \
    LOG_LEVEL=INFO \
    API_HOST=0.0.0.0 \
    API_PORT=8000

EXPOSE 8000

ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "agent.serve"]
