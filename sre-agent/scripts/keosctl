cmd_context() {
  _check_help context "$@"
  kc_cluster config current-context
}

# ─── Subcommand: version ─────────────────────────────────────────────────────

cmd_version() {
  _check_help version "$@"
  printf "${C_BOLD}keosctl${C_RST}      v%s\n" "$KEOSCTL_VERSION"
  local chart
  if chart=$(helm list -n "$NAMESPACE" -f "^${RELEASE}\$" -o json 2>/dev/null | \
             jq_inline 'print(d[0]["chart"]) if d else exit(1)' 2>/dev/null); then
    printf "Helm chart   %s\n" "$chart"
  else
    printf "Helm chart   ${C_DIM}(not installed in this namespace)${C_RST}\n"
  fi
  printf "Repo root    %s\n" "$REPO_ROOT"
  printf "Bash         %s\n" "${BASH_VERSION}"
}

# ─── Subcommand: link (symlink to ~/.local/bin) ──────────────────────────────

cmd_link() {
  _check_help link "$@"
  local target="${1:-$HOME/.local/bin/keosctl}"
  mkdir -p "$(dirname "$target")"
  ln -sfn "$SCRIPT_DIR/keosctl" "$target"
  ok "keosctl linked at $target"
  if ! command -v keosctl >/dev/null 2>&1; then
    note "Add this to your shell profile if 'keosctl' isn't on PATH yet:"
    note "  export PATH=\"\$HOME/.local/bin:\$PATH\""
  else
    note "Already on PATH — try: keosctl status"
  fi
}

# ─── Subcommand: events / incidents ──────────────────────────────────────────

cmd_events() {
  _check_help events "$@"
  require_namespace
  local limit=10 watch=0 filter="" since="" domain=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--limit) limit="$2"; shift 2 ;;
      -w|--watch) watch=1; shift ;;
      --filter)   filter="$2"; shift 2 ;;
      --since)    since="$2"; shift 2 ;;
      --domain)   domain="$2"; shift 2 ;;   # sre | security (Phase 21)
      *) die "unrecognized argument '$1' — run this command with -h/--help to see valid options." ;;
    esac
  done
  # Future API extension hook — filter / since / domain not enforced on the
  # server yet, applied client-side after fetch.
  _filter_outcome="${filter#outcome=}"
  _render_events() {
    heading "Recent incidents${domain:+ · domain=$domain}"
    api_curl "/api/incidents?limit=$limit" 2>/dev/null | KEOS_DOMAIN="$domain" python3 -c "
import json, os, sys
raw = sys.stdin.read() or '[]'
want = (os.environ.get('KEOS_DOMAIN') or '').strip()
try:
    data = json.loads(raw)
except Exception:
    print('  ${C_RED}✗${C_RST} could not parse API response'); sys.exit(0)
items = data if isinstance(data, list) else data.get('items', [])
if want:
    items = [i for i in items if (i.get('domain') or 'sre') == want]
if not items:
    print('  ${C_DIM}No incidents yet — try \"keosctl run lib-reverse-shell\".${C_RST}')
else:
    for i in items[:$limit]:
        ts = (i.get('triage_ts') or i.get('ts') or '?')[:19]
        rule = i.get('rule_id') or i.get('rule') or '?'
        outcome = i.get('outcome') or ('escalated' if i.get('escalated') else ('healed' if i.get('healed') else '?'))
        tool = i.get('proposed_tool') or (i.get('proposed_action') or {}).get('tool') or '?'
        dom = i.get('domain') or 'sre'
        dtag = '${C_RED}SEC${C_RST}' if dom == 'security' else '${C_DIM}sre${C_RST}'
        color = '${C_GREEN}' if outcome == 'healed' else '${C_YELLOW}' if outcome == 'escalated' else '${C_RED}' if outcome == 'failed' else '${C_DIM}'
        print(f'  {color}●${C_RST}  {ts:<20} {dtag:<14} {rule:<26} {tool:<18} {color}{outcome}${C_RST}')
" 2>/dev/null || warn "API unreachable — is the api pod Ready?"
  }
  if [[ $watch -eq 1 ]]; then
    while true; do clear; _render_events; printf "\n${C_DIM}Refreshing every 3s — Ctrl-C to stop${C_RST}\n"; sleep 3; done
  else
    _render_events
  fi
}

# ─── Subcommand: usecases ────────────────────────────────────────────────────

cmd_usecases() {
  _check_help usecases "$@"
  require_namespace
  local action="${1:-list}"
  shift || true
  case "$action" in
    list)
      local uc_domain=""
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --domain) uc_domain="$2"; shift 2 ;;   # sre | security (Phase 21)
          *) shift ;;
        esac
      done
      heading "Available use cases${uc_domain:+ · domain=$uc_domain}"
      api_curl "/api/usecases" 2>/dev/null | KEOS_DOMAIN="$uc_domain" python3 -c "
import json, os, sys
want = (os.environ.get('KEOS_DOMAIN') or '').strip()
data = json.load(sys.stdin)
items = data if isinstance(data, list) else data.get('items', [])
if want:
    items = [u for u in items if (u.get('domain') or 'sre') == want]
for u in items:
    slug = u.get('slug') or u.get('id') or '?'
    title = u.get('name') or u.get('title_en') or u.get('description_en') or '?'
    dom = u.get('domain') or 'sre'
    dtag = '${C_RED}SEC${C_RST}' if dom == 'security' else '${C_DIM}sre${C_RST}'
    print(f'  {dtag:<14} ${C_CYAN}{slug:<24}${C_RST}  {title}')
" 2>/dev/null || warn "Could not fetch use cases (API down?)"
      ;;
    show)
      local slug="${1:-}"; [[ -z "$slug" ]] && die "usage: keosctl usecases show <slug>"
      api_curl "/api/usecases/$slug" | python3 -m json.tool
      ;;
    *) die "unknown action '$action' — valid: list, show" ;;
  esac
}

# ─── Subcommand: run (trigger a use case) ────────────────────────────────────

cmd_run() {
  _check_help run "$@"
  require_namespace
  local slug="" dry_run=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) dry_run=1; shift ;;
      *) [[ -z "$slug" ]] && slug="$1" && shift || { shift; } ;;
    esac
  done
  [[ -z "$slug" ]] && die "usage: keosctl run <use-case-slug> [--dry-run]"
  if [[ $dry_run -eq 1 ]]; then
    heading "Dry-run for use case '$slug'"
    api_curl "/api/usecases/$slug" 2>/dev/null | python3 -m json.tool
    note "Would fire the above synthetic event onto NATS infra.events.*"
    return 0
  fi
  heading "Running use case '$slug'"
  local resp
  resp="$(api_curl "/api/usecases/$slug/run" -X POST 2>&1)" || die "API call failed: $resp"
  echo "$resp" | python3 -c "
import json, sys
data = json.loads(sys.stdin.read() or '{}')
iid = data.get('incident_id') or '?'
print(f'  ${C_GREEN}✓${C_RST} Incident id: ${C_BOLD}{iid}${C_RST}')
print('  Watch live: ${C_CYAN}keosctl events -w${C_RST}')
print('  Open SPA:   ${C_CYAN}keosctl ui${C_RST}  (Pipeline tab)')
" 2>/dev/null || echo "$resp"
}

# ─── Subcommand: restart ─────────────────────────────────────────────────────

cmd_restart() {
  _check_help restart "$@"
  require_namespace
  local component="" wait_ready=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wait) wait_ready=1; shift ;;
      *) [[ -z "$component" ]] && component="$1" && shift || { shift; } ;;
    esac
  done
  [[ -z "$component" ]] && die "usage: keosctl restart <component> [--wait]"
  case "$component" in
    api|mcp-server|frontend|caddy|opa)
      kc rollout restart "deploy/$component"
      ok "Restarted deployment/$component"
      if [[ $wait_ready -eq 1 ]]; then
        kc rollout status "deploy/$component" --timeout=2m 2>&1 | tail -3
      fi
      ;;
    ollama|qdrant|nats)
      kc delete pod -l "app.kubernetes.io/component=$component"
      ok "Recycled $component pod (StatefulSet will respawn it)"
      if [[ $wait_ready -eq 1 ]]; then
        kc wait --for=condition=Ready pod -l "app.kubernetes.io/component=$component" --timeout=2m 2>&1 | tail -3
      fi
      ;;
    *) die "unknown component '$component'" ;;
  esac
}

# ─── Subcommand: shell ───────────────────────────────────────────────────────

cmd_shell() {
  _check_help shell "$@"
  require_namespace
  local component="${1:-api}"
  shift || true
  local pod="$(pod_for "$component")"
  [[ -z "$pod" ]] && die "no pod for component '$component'"
  # Try bash, fall back to sh.
  kc exec -it "$pod" -- bash 2>/dev/null || kc exec -it "$pod" -- sh
}

# ─── Subcommand: describe ────────────────────────────────────────────────────

cmd_describe() {
  _check_help describe "$@"
  require_namespace
  local component="${1:-}"
  [[ -z "$component" ]] && die "usage: keosctl describe <component>"
  local pod="$(pod_for "$component")"
  [[ -z "$pod" ]] && die "no pod for component '$component'"
  kc describe pod "$pod"
}

# ─── Subcommand: port-forward ────────────────────────────────────────────────

cmd_portforward() {
  _check_help port-forward "$@"
  require_namespace
  local component="${1:-}" port="${2:-}"
  [[ -z "$component" || -z "$port" ]] && die "usage: keosctl port-forward <component> <local-port>"
  local target_port
  case "$component" in
    api)        target_port=8000 ;;
    mcp-server) target_port=8090 ;;
    frontend)   target_port=8080 ;;
    caddy|pocteo) component=pocteo; target_port=80 ;;
    ollama)     target_port=11434 ;;
    qdrant)     target_port=6333 ;;
    nats)       target_port=4222 ;;
    opa)        target_port=8181 ;;
    *) die "unknown component '$component'" ;;
  esac
  info "Forwarding svc/$component :$target_port → localhost:$port"
  kc port-forward "svc/$component" "$port:$target_port"
}

# ─── Subcommand: upgrade ─────────────────────────────────────────────────────

cmd_upgrade() {
  _check_help upgrade "$@"
  local chart_version="" dry_run=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --chart-version) chart_version="$2"; shift 2 ;;
      --dry-run)       dry_run=1; shift ;;
      *) die "unrecognized argument '$1' — run this command with -h/--help to see valid options." ;;
    esac
  done
  require_namespace
  heading "Upgrading Keos"
  local args=(upgrade "$RELEASE" "$REPO_ROOT/deploy/helm/pocteo"
              -n "$NAMESPACE" --reuse-values --wait --timeout 5m)
  if [[ -n "$chart_version" ]]; then
    args=(upgrade "$RELEASE" "oci://ghcr.io/pocteo-platform/charts/pocteo"
          --version "$chart_version" -n "$NAMESPACE" --reuse-values --wait --timeout 5m)
  fi
  if [[ $dry_run -eq 1 ]]; then
    args+=(--dry-run)
    note "Dry-run: showing the diff helm would apply"
  fi
  helm "${args[@]}" 2>&1 | tail -12
  [[ $dry_run -eq 0 ]] && ok "Upgrade complete. Run 'keosctl status' to verify."
}

# ─── Subcommand: audit ───────────────────────────────────────────────────────

cmd_audit() {
  _check_help audit "$@"
  require_namespace
  local action="${1:-tail}"
  shift || true
  local api_pod="$(pod_for api)"
  [[ -z "$api_pod" ]] && die "api pod not found"
  case "$action" in
    tail)
      local n=20
      [[ "${1:-}" == "-n" || "${1:-}" == "--lines" ]] && { n="$2"; shift 2; }
      kc exec "$api_pod" -- tail -n "$n" /app/audit.log 2>/dev/null \
        || warn "audit.log not found yet (no incidents recorded?)"
      ;;
    verify)
      kc exec "$api_pod" -- python -m agent.audit --verify 2>&1 | tail -10
      ;;
    *) die "unknown action '$action' — valid: tail, verify" ;;
  esac
}

# ─── Subcommand: completion ──────────────────────────────────────────────────

cmd_completion() {
  _check_help completion "$@"
  local shell_kind="${1:-bash}"
  case "$shell_kind" in
    bash)
      cat <<'COMPLETION'
# bash completion for keosctl. Source from .bashrc:
#   eval "$(keosctl completion bash)"
_keosctl_complete() {
  local cur prev cmds
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  cmds="install gitops release bundle falco-probe uninstall link status doctor preflight gpu-setup mode logs ui token seed models
        events incidents usecases run restart shell describe port-forward upgrade
        audit completion context version help api backup restore diag calibration
        config chaos top update deps images values policy runbooks bus"
  case "$prev" in
    keosctl)        COMPREPLY=( $(compgen -W "$cmds" -- "$cur") ) ;;
    logs|restart|shell|describe|port-forward)
      COMPREPLY=( $(compgen -W "api mcp-server frontend caddy ollama qdrant nats opa" -- "$cur") ) ;;
    mode)           COMPREPLY=( $(compgen -W "observe-only active frozen" -- "$cur") ) ;;
    models)         COMPREPLY=( $(compgen -W "list pull rm show" -- "$cur") ) ;;
    audit)          COMPREPLY=( $(compgen -W "tail verify" -- "$cur") ) ;;
    completion)     COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") ) ;;
    usecases)       COMPREPLY=( $(compgen -W "list show" -- "$cur") ) ;;
    incidents)      COMPREPLY=( $(compgen -W "list get delete" -- "$cur") ) ;;
    calibration|cal) COMPREPLY=( $(compgen -W "list set reset" -- "$cur") ) ;;
    chaos)          COMPREPLY=( $(compgen -W "list delete" -- "$cur") ) ;;
    config)         COMPREPLY=( $(compgen -W "view" -- "$cur") ) ;;
    deps)           COMPREPLY=( $(compgen -W "list install verify" -- "$cur") ) ;;
    images|image)   COMPREPLY=( $(compgen -W "list registry set-registry pull-policy" -- "$cur") ) ;;
    values)         COMPREPLY=( $(compgen -W "get set edit diff" -- "$cur") ) ;;
    policy)         COMPREPLY=( $(compgen -W "show test" -- "$cur") ) ;;
    runbooks)       COMPREPLY=( $(compgen -W "list show" -- "$cur") ) ;;
    bus)            COMPREPLY=( $(compgen -W "tail streams" -- "$cur") ) ;;
  esac
}
complete -F _keosctl_complete keosctl
COMPLETION
      ;;
    zsh)
      cat <<'COMPLETION'
# zsh completion for keosctl. Source from .zshrc:
#   eval "$(keosctl completion zsh)"
_keosctl() {
  local -a cmds
  cmds=(install gitops release bundle falco-probe uninstall link status doctor preflight gpu-setup mode logs ui token seed models
        events usecases run restart shell describe port-forward upgrade
        audit completion context version help)
  if (( CURRENT == 2 )); then
    _describe 'command' cmds
  fi
}
compdef _keosctl keosctl
COMPLETION
      ;;
    fish)
      cat <<'COMPLETION'
# fish completion for keosctl. Save as ~/.config/fish/completions/keosctl.fish
complete -c keosctl -f
for cmd in install uninstall link status doctor preflight gpu-setup mode logs ui token seed models events usecases run restart shell describe port-forward upgrade audit completion context version help
  complete -c keosctl -n "__fish_use_subcommand" -a $cmd
end
COMPLETION
      ;;
    *) die "unsupported shell '$shell_kind' — valid: bash, zsh, fish" ;;
  esac
}

# ─── Subcommand: api (raw API access) ────────────────────────────────────────

cmd_api() {
  _check_help api "$@"
  require_namespace
  local path="${1:-}"
  shift || true
  [[ -z "$path" ]] && die "usage: keosctl api <path> [curl options...]  (e.g. keosctl api /api/health)"
  api_curl "$path" "$@"
  echo
}

# ─── Subcommand: incidents (get / delete) ────────────────────────────────────

cmd_incidents() {
  _check_help incidents "$@"
  require_namespace
  local action="${1:-list}"
  shift || true
  case "$action" in
    list)
      cmd_events "$@"
      ;;
    get)
      local iid="${1:-}"
      [[ -z "$iid" ]] && die "usage: keosctl incidents get <incident-id>"
      api_curl "/api/incidents/$iid" 2>/dev/null | python3 -m json.tool 2>/dev/null \
        || die "incident '$iid' not found or API unreachable"
      ;;
    delete|rm)
      local iid="${1:-}"
      [[ -z "$iid" ]] && die "usage: keosctl incidents delete <incident-id>"
      api_curl "/api/incidents/$iid" -X DELETE 2>/dev/null && ok "Deleted incident $iid" \
        || warn "Could not delete (API may not support DELETE on incidents — check audit log instead)"
      ;;
    *) die "unknown action '$action' — valid: list, get, delete" ;;
  esac
}

# ─── Subcommand: backup ──────────────────────────────────────────────────────

cmd_backup() {
  _check_help backup "$@"
  require_namespace
  local out="" include_models=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -o|--output) out="$2"; shift 2 ;;
      --include-models) include_models=1; shift ;;
      *) die "unrecognized argument '$1' — run this command with -h/--help to see valid options." ;;
    esac
  done
  out="${out:-keos-backup-$(date +%Y%m%d-%H%M%S).tar.gz}"
  heading "Backing up Keos state"
  local tmpdir
  tmpdir=$(mktemp -d)
  trap "rm -rf '$tmpdir'" RETURN

  info "Helm values"
  helm get values "$RELEASE" -n "$NAMESPACE" -a > "$tmpdir/helm-values.yaml" 2>/dev/null || warn "helm values failed"

  info "AgentMode CR"
  kc_cluster get agentmode default -o yaml > "$tmpdir/agentmode.yaml" 2>/dev/null || warn "no AgentMode CR"

  info "Audit log"
  local api_pod="$(pod_for api)"
  if [[ -n "$api_pod" ]]; then
    kc cp "$api_pod:/app/audit.log" "$tmpdir/audit.log" 2>/dev/null || warn "audit.log not found in api pod"
  fi

  info "Qdrant snapshot"
  local qdrant_pod="$(pod_for qdrant)"
  if [[ -n "$qdrant_pod" ]]; then
    kc exec "$qdrant_pod" -- curl -sf -X POST http://localhost:6333/collections/runbooks/snapshots >/dev/null 2>&1 || true
    kc cp "$qdrant_pod:/qdrant/snapshots" "$tmpdir/qdrant-snapshots" 2>/dev/null || warn "qdrant snapshots not found"
  fi

  if [[ $include_models -eq 1 ]]; then
    info "Ollama models (this can be GIGABYTES)"
    local ollama_pod="$(pod_for ollama)"
    [[ -n "$ollama_pod" ]] && kc cp "$ollama_pod:/root/.ollama" "$tmpdir/ollama-models" 2>/dev/null
  fi

  info "Manifest snapshot"
  kc get all,cm,secret,pvc,networkpolicy,pdb -o yaml > "$tmpdir/manifests.yaml" 2>/dev/null

  echo "keos-backup-version: 1" > "$tmpdir/META"
  echo "ts: $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$tmpdir/META"
  echo "namespace: $NAMESPACE" >> "$tmpdir/META"
  echo "release: $RELEASE" >> "$tmpdir/META"
  echo "include_models: $include_models" >> "$tmpdir/META"

  tar -czf "$out" -C "$tmpdir" . 2>/dev/null
  local size=$(du -h "$out" 2>/dev/null | awk '{print $1}')
  ok "Backup written to $out ($size)"
}

# ─── Subcommand: restore ─────────────────────────────────────────────────────

cmd_restore() {
  _check_help restore "$@"
  require_namespace
  local archive="${1:-}"
  [[ -z "$archive" ]] && die "usage: keosctl restore <backup.tar.gz>"
  [[ -r "$archive" ]] || die "cannot read $archive"
  heading "Restoring Keos state from $archive"
  local tmpdir
  tmpdir=$(mktemp -d)
  trap "rm -rf '$tmpdir'" RETURN
  tar -xzf "$archive" -C "$tmpdir"
  [[ -f "$tmpdir/META" ]] || die "$archive doesn't look like a keosctl backup (no META file)"
  say "Restoring from: $(grep ^ts: "$tmpdir/META")"

  if [[ -f "$tmpdir/agentmode.yaml" ]]; then
    kc_cluster apply -f "$tmpdir/agentmode.yaml" >/dev/null 2>&1 && ok "AgentMode CR restored"
  fi

  local api_pod="$(pod_for api)"
  if [[ -n "$api_pod" && -f "$tmpdir/audit.log" ]]; then
    kc cp "$tmpdir/audit.log" "$api_pod:/app/audit.log" 2>/dev/null && ok "audit.log restored"
  fi

  if [[ -d "$tmpdir/qdrant-snapshots" ]]; then
    local qdrant_pod="$(pod_for qdrant)"
    if [[ -n "$qdrant_pod" ]]; then
      kc cp "$tmpdir/qdrant-snapshots" "$qdrant_pod:/qdrant/snapshots" 2>/dev/null && \
        warn "qdrant snapshot files copied — restore via: kubectl exec $qdrant_pod -- curl -X PUT http://localhost:6333/collections/runbooks/snapshots/recover -d '{\"location\":\"<file>\"}'"
    fi
  fi

  if [[ -d "$tmpdir/ollama-models" ]]; then
    local ollama_pod="$(pod_for ollama)"
    [[ -n "$ollama_pod" ]] && kc cp "$tmpdir/ollama-models" "$ollama_pod:/root/.ollama" 2>/dev/null && ok "ollama models restored"
  fi
  ok "Restore complete. Run 'keosctl doctor' to verify."
}

# ─── Subcommand: diag (support bundle) ───────────────────────────────────────

cmd_diag() {
  _check_help diag "$@"
  require_namespace
  local out="${1:-keos-diag-$(date +%Y%m%d-%H%M%S).tar.gz}"
  heading "Generating support bundle"
  local tmpdir
  tmpdir=$(mktemp -d)
  trap "rm -rf '$tmpdir'" RETURN

  info "Cluster snapshot"
  kc_cluster cluster-info dump --output-directory="$tmpdir/cluster" >/dev/null 2>&1 || true
  kc_cluster get nodes -o yaml > "$tmpdir/nodes.yaml" 2>/dev/null
  kc_cluster version > "$tmpdir/k8s-version.txt" 2>&1

  info "Keos namespace state"
  kc get all,cm,secret,pvc,networkpolicy,pdb,events -o yaml > "$tmpdir/ns-all.yaml" 2>/dev/null
  kc describe pods > "$tmpdir/pods-describe.txt" 2>/dev/null

  info "Helm release"
  helm get all "$RELEASE" -n "$NAMESPACE" > "$tmpdir/helm-all.yaml" 2>/dev/null

  info "Component logs (last 500 lines each)"
  mkdir -p "$tmpdir/logs"
  for c in api mcp-server frontend caddy ollama qdrant nats opa; do
    kc logs -l "app.kubernetes.io/component=$c" --tail=500 > "$tmpdir/logs/$c.log" 2>&1 || true
  done

  info "AgentMode CR + audit chain head"
  kc_cluster get agentmode default -o yaml > "$tmpdir/agentmode.yaml" 2>/dev/null
  local api_pod="$(pod_for api)"
  if [[ -n "$api_pod" ]]; then
    kc exec "$api_pod" -- tail -n 100 /app/audit.log > "$tmpdir/audit-tail.jsonl" 2>/dev/null || true
  fi

  info "Doctor output"
  cmd_doctor > "$tmpdir/doctor.txt" 2>&1 || true

  info "Versions"
  cmd_version > "$tmpdir/versions.txt" 2>&1

  echo "keos-diag-version: 1" > "$tmpdir/META"
  echo "ts: $(date -u +%Y-%m-%dT%H:%M:%SZ)" >> "$tmpdir/META"
  echo "namespace: $NAMESPACE" >> "$tmpdir/META"
  echo "release: $RELEASE" >> "$tmpdir/META"

  tar -czf "$out" -C "$tmpdir" . 2>/dev/null
  local size=$(du -h "$out" 2>/dev/null | awk '{print $1}')
  ok "Support bundle written to $out ($size)"
  note "Attach this when filing a GitHub issue or contacting support."
}

# ─── Subcommand: calibration ─────────────────────────────────────────────────

cmd_calibration() {
  _check_help calibration "$@"
  require_namespace
  local action="${1:-list}"
  shift || true
  case "$action" in
    list|ls)
      heading "Per-rule calibration"
      api_curl "/api/calibration" 2>/dev/null | python3 -c "
import json, sys
data = json.load(sys.stdin) if sys.stdin.isatty() == False else []
rows = data if isinstance(data, list) else data.get('items', [])
if not rows:
    print('  ${C_DIM}No calibration data yet (need ≥10 incidents per rule).${C_RST}')
else:
    print('  ${C_BOLD}RULE                            n   p50_conf  p90_conf  threshold${C_RST}')
    for r in rows:
        print(f'  {r.get(\"rule_id\",\"?\"):<30}  {r.get(\"n_incidents\",0):>3}    {r.get(\"p50_conf\",0):.2f}      {r.get(\"p90_conf\",0):.2f}      {r.get(\"threshold\",0):.2f}')
" 2>/dev/null || warn "calibration API not reachable"
      ;;
    set)
      local rule="${1:-}" threshold="${2:-}"
      [[ -z "$rule" || -z "$threshold" ]] && die "usage: keosctl calibration set <rule_id> <threshold>"
      api_curl "/api/calibration/$rule/threshold" -X POST -H "Content-Type: application/json" \
        -d "{\"threshold\":$threshold}" >/dev/null 2>&1 \
        && ok "Threshold for '$rule' set to $threshold" \
        || die "calibration update rejected — the threshold must be a number between 0.0 and 1.0.  (try: keosctl calibration --help)"
      ;;
    reset)
      local rule="${1:-}"
      if [[ -z "$rule" || "$rule" == "--all" ]]; then
        api_curl "/api/calibration/reset" -X POST >/dev/null 2>&1 && ok "All per-rule thresholds reset"
      else
        api_curl "/api/calibration/$rule/threshold" -X DELETE >/dev/null 2>&1 && ok "Threshold for '$rule' reset"
      fi
      ;;
    *) die "unknown action '$action' — valid: list, set, reset" ;;
  esac
}

# ─── Subcommand: config (view effective configuration) ───────────────────────

cmd_config() {
  _check_help config "$@"
  local action="${1:-view}"
  shift || true
  case "$action" in
    view|show)
      heading "Effective configuration"
      info "Namespace      $NAMESPACE"
      info "Release        $RELEASE"
      local ctx
      ctx=$(kc_cluster config current-context 2>/dev/null || echo '?')
      info "Kubeconfig     ${KUBECONFIG_OVERRIDE:-${KUBECONFIG:-$HOME/.kube/config}}"
      info "Context        $ctx"
      local mode chart
      mode=$(kc_cluster get agentmode default -o jsonpath='{.spec.mode}' 2>/dev/null || echo '(unknown)')
      info "Agent mode     $mode"
      chart=$(helm list -n "$NAMESPACE" -f "^${RELEASE}\$" -o json 2>/dev/null | \
                jq_inline 'print(d[0]["chart"]) if d else print("(not installed)")' 2>/dev/null || echo "?")
      info "Helm chart     $chart"
      local models
      models=$(kc exec "$(pod_for ollama)" -- ollama list 2>/dev/null | tail -n +2 | awk '{print $1}' | paste -sd ',' -)
      info "Models         ${models:-(none)}"
      printf "\n  ${C_DIM}Env overrides honoured: KEOS_NAMESPACE, KEOS_RELEASE${C_RST}\n"
      ;;
    *) die "unknown action '$action' — valid: view" ;;
  esac
}

# ─── Subcommand: chaos (list / delete chaos-mesh experiments) ────────────────

cmd_chaos() {
  _check_help chaos "$@"
  local action="${1:-list}"
  shift || true
  case "$action" in
    list|ls)
      heading "Chaos Mesh experiments"
      kc_cluster get podchaos,stresschaos,networkchaos,iochaos -A 2>/dev/null \
        | grep -v "^NAMESPACE.*NAME" || say "  ${C_DIM}No chaos experiments running.${C_RST}"
      ;;
    delete|rm)
      local name="${1:-}" ns="${2:-${NAMESPACE}}"
      [[ -z "$name" ]] && die "usage: keosctl chaos delete <name> [namespace]"
      kc_cluster -n "$ns" delete podchaos,stresschaos,networkchaos,iochaos "$name" 2>&1 | tail -3
      ;;
    *) die "unknown action '$action' — valid: list, delete" ;;
  esac
}

# ─── Subcommand: top (live one-screen dashboard) ─────────────────────────────

cmd_top() {
  _check_help top "$@"
  require_namespace
  local interval=2
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval) interval="$2"; shift 2 ;;
      *) die "unrecognized argument '$1' — run this command with -h/--help to see valid options." ;;
    esac
  done
  while true; do
    clear
    heading "Keos · live"
    local mode
    mode=$(kc_cluster get agentmode default -o jsonpath='{.spec.mode}' 2>/dev/null || echo '?')
    printf "  Mode: ${C_BOLD}%s${C_RST}   |   Namespace: ${C_DIM}%s${C_RST}\n\n" "$mode" "$NAMESPACE"
    printf "${C_BOLD}Pods${C_RST}\n"
    kc get pods --no-headers 2>/dev/null | awk '{printf "  %-44s %-10s %s\n", $1, $2, $3}' | head -15
    printf "\n${C_BOLD}Latest incidents${C_RST}\n"
    api_curl "/api/incidents?limit=5" 2>/dev/null | python3 -c "
import json, sys
items = json.load(sys.stdin) if sys.stdin else []
items = items if isinstance(items, list) else items.get('items', [])
for i in items[:5]:
    ts = (i.get('triage_ts') or '?')[:19]
    print(f'  {ts}  {i.get(\"rule_id\",\"?\"):<28} {i.get(\"outcome\",\"?\")}')
" 2>/dev/null || say "  ${C_DIM}(API unreachable)${C_RST}"
    printf "\n${C_DIM}Refreshing every %ss · Ctrl-C to stop${C_RST}\n" "$interval"
    sleep "$interval"
  done
}

# ─── Subcommand: update (check newer keosctl) ────────────────────────────────

cmd_update() {
  _check_help update "$@"
  heading "Checking for updates"
  local latest
  latest=$(curl -fsSL --max-time 5 \
    https://api.github.com/repos/pocteo-platform/keos/releases/latest 2>/dev/null \
    | grep -E '"tag_name"' | head -1 | sed -E 's/.*"v?([^"]+)".*/\1/')
  if [[ -z "$latest" ]]; then
    warn "Could not reach github.com — try 'git pull' in the repo manually"
    return 0
  fi
  info "Installed     v$KEOSCTL_VERSION"
  info "Latest        v$latest"
  if [[ "$latest" == "$KEOSCTL_VERSION" ]]; then
    ok "You're on the latest version."
    return 0
  fi
  warn "Newer version available."
  note "Update with:"
  note "  cd $REPO_ROOT && git pull && keosctl link"
}

# ─── Subcommand: deps (detect + install ecosystem operators) ─────────────────

cmd_deps() {
  _check_help deps "$@"
  local action="${1:-list}"
  shift || true
  case "$action" in
    list|ls|verify)
      heading "Ecosystem operators"
      _dep_row() {
        local label="$1" probe="$2" impact="$3"
        if eval "$probe" >/dev/null 2>&1; then
          printf "  ${C_GREEN}${CHECK}${C_RST} %-22s ${C_DIM}detected${C_RST}\n" "$label"
        else
          printf "  ${C_RED}${CROSS}${C_RST} %-22s ${C_DIM}not installed — %s${C_RST}\n" "$label" "$impact"
        fi
      }
      _dep_row "Chaos Mesh"        "kc_cluster get crd podchaos.chaos-mesh.org 2>/dev/null" \
                                   "use cases can't apply ChaosExperiments"
      _dep_row "Prometheus"         "kc_cluster get svc -A 2>/dev/null | grep -qE 'prometheus|kube-prometheus'" \
                                   "baselines + forecasts disabled (Phase 13/14)"
      _dep_row "kube-state-metrics" "kc_cluster get svc -A 2>/dev/null | grep -q kube-state-metrics" \
                                   "some baseline metrics will fail"
      _dep_row "Argo CD"            "kc_cluster get crd applications.argoproj.io 2>/dev/null" \
                                   "GitOps drift falls back to filesystem manifests"
      _dep_row "Flux"               "kc_cluster get crd kustomizations.kustomize.toolkit.fluxcd.io 2>/dev/null" \
                                   "GitOps drift falls back to filesystem manifests"
      _dep_row "cert-manager"       "kc_cluster get crd certificates.cert-manager.io 2>/dev/null" \
                                   "Phase 19 mTLS will fall back to self-signed"
      _dep_row "Falco"              "kc_cluster get ds -A 2>/dev/null | grep -qi falco" \
                                   "security domain has no live Falco detection (synthetic events still work)"
      _dep_row "Tetragon"           "kc_cluster get crd tracingpolicies.cilium.io 2>/dev/null" \
                                   "security domain has no live Tetragon eBPF events (synthetic events still work)"
      printf "\n  ${C_DIM}Install a missing one: keosctl deps install <name>${C_RST}\n"
      ;;
    install)
      local name="${1:-}"; shift || true
      [[ -z "$name" ]] && die "usage: keosctl deps install <prometheus|argocd|flux|cert-manager|kube-state-metrics|falco|tetragon> [--chart-repo URL] [--version V] [--values FILE] [--namespace NS]"
      local chart_repo="" version="" values="" ns="" set_args=()
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --chart-repo) chart_repo="$2"; shift 2 ;;
          --version)    version="$2"; shift 2 ;;
          --values)     values="$2"; shift 2 ;;
          --namespace)  ns="$2"; shift 2 ;;
          --set)        set_args+=(--set "$2"); shift 2 ;;
          *) die "unrecognized argument '$1' — run this command with -h/--help to see valid options." ;;
        esac
      done
      local def_repo="" def_chart="" def_ns="" def_version=""
      case "$name" in
        prometheus|kube-prometheus-stack)
          def_repo="https://prometheus-community.github.io/helm-charts"
          def_chart="kube-prometheus-stack"; def_ns="monitoring"
          ;;
        argocd|argo)
          def_repo="https://argoproj.github.io/argo-helm"
          def_chart="argo-cd"; def_ns="argocd"
          ;;
        flux)
          def_repo="oci://ghcr.io/fluxcd-community/charts"
          def_chart="flux2"; def_ns="flux-system"
          ;;
        cert-manager)
          def_repo="https://charts.jetstack.io"
          def_chart="cert-manager"; def_ns="cert-manager"
          set_args+=(--set "installCRDs=true")
          ;;
        kube-state-metrics)
          def_repo="https://prometheus-community.github.io/helm-charts"
          def_chart="kube-state-metrics"; def_ns="monitoring"
          ;;
        falco)
          # Security domain (Phase 21) — Falco for live eBPF detection, same
          # version as the chart's `falco` sub-chart (modern_ebpf, BTF
          # kernels). Alerts go through falcosidekick: Falco's own
          # http_output can't send the Authorization header the agent
          # webhook requires. The token is the one in the agent's auth secret.
          def_repo="https://falcosecurity.github.io/charts"
          def_chart="falco"; def_ns="falco"; def_version="9.2.0"
          local auth_secret falco_tok
          auth_secret=$(kc get deploy -l app.kubernetes.io/component=api \
            -o jsonpath='{.items[0].spec.template.spec.containers[*].envFrom[*].secretRef.name}' 2>/dev/null | awk '{print $1}')
          falco_tok=$(kc get secret "${auth_secret:-${RELEASE}-pocteo-auth}" \
            -o jsonpath='{.data.FALCO_WEBHOOK_TOKEN}' 2>/dev/null | base64 -d 2>/dev/null)
          [[ -n "$falco_tok" ]] || die "no FALCO_WEBHOOK_TOKEN in the agent's auth secret (ns/$NAMESPACE) — without it the webhook refuses every alert.
   Set one on the Keos release (--set-string auth.falcoWebhookToken=\$(openssl rand -hex 16)), or reinstall with security on."
          set_args+=(--set "driver.kind=modern_ebpf")
          set_args+=(--set "falco.json_output=true")
          set_args+=(--set "falcosidekick.enabled=true")
          set_args+=(--set-string "falcosidekick.config.webhook.address=http://api.${NAMESPACE}.svc.cluster.local:8000/api/webhooks/falco")
          set_args+=(--set-string "falcosidekick.config.webhook.customHeaders=Authorization:Bearer ${falco_tok}")
          set_args+=(--set-string "falcosidekick.config.webhook.minimumpriority=notice")
          [[ "${ns:-falco}" == "falco" ]] \
            || note "The agent's NetworkPolicy admits falcosidekick from ns/falco and ns/$NAMESPACE only."
          ;;
        tetragon)
          # Security domain (Phase 21) — Tetragon for eBPF process/network events.
          def_repo="https://helm.cilium.io"
          def_chart="tetragon"; def_ns="kube-system"; def_version="1.4.1"
          set_args+=(--set "tetragon.enableProcessCred=true")
          set_args+=(--set "tetragon.enableProcessNs=true")
          ;;
        *) die "unknown operator '$name' — valid: prometheus, argocd, flux, cert-manager, kube-state-metrics, falco, tetragon" ;;
      esac
      chart_repo="${chart_repo:-$def_repo}"
      ns="${ns:-$def_ns}"
      version="${version:-$def_version}"
      info "Installing $name into ns/$ns from $chart_repo${version:+ (version $version)}"
      local helm_args
      if [[ "$chart_repo" == oci://* ]]; then
        helm_args=(upgrade --install "$name" "$chart_repo/$def_chart"
                    -n "$ns" --create-namespace --wait --timeout 5m)
      else
        helm repo add "${name}-repo" "$chart_repo" >/dev/null 2>&1 || true
        helm repo update "${name}-repo" >/dev/null 2>&1 || true
        helm_args=(upgrade --install "$name" "${name}-repo/$def_chart"
                    -n "$ns" --create-namespace --wait --timeout 5m)
      fi
      [[ -n "$version" ]] && helm_args+=(--version "$version")
      [[ -n "$values" ]] && helm_args+=(-f "$values")
      helm_args+=("${set_args[@]}")
      helm "${helm_args[@]}" 2>&1 | tail -8
      ok "$name installed."
      note "Run 'keosctl deps list' to confirm; 'keosctl restart api --wait' to make the agent re-discover."
      ;;
    *) die "unknown action '$action' — valid: list, install, verify" ;;
  esac
}

# ─── Subcommand: images (list / registry / set-registry / pull-policy) ───────

cmd_images() {
  _check_help images "$@"
  # `audit` is a WORKSTATION action (skopeo/manifest inspect of registry tags) —
  # it needs no cluster, so intercept it before require_namespace.
  if [[ "${1:-}" == "audit" ]]; then
    shift
    exec bash "$(_helper audit-images.sh)" "$@"
  fi
  require_namespace
  local action="${1:-list}"
  shift || true
  case "$action" in
    list|ls)
      heading "Images currently running in ns/$NAMESPACE"
      kc get pods -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.spec.containers[*].image}{"\n"}{end}' 2>/dev/null \
        | awk -F'\t' '{ printf "  %-42s %s\n", $1, $2 }' | head -30
      ;;
    registry)
      heading "Image registry configuration"
      local reg
      reg=$(helm get values "$RELEASE" -n "$NAMESPACE" -a 2>/dev/null \
              | grep -E '^\s+imageRegistry:' | head -1 | awk '{print $2}')
      info "global.imageRegistry   ${reg:-(unset — using upstream registries)}"
      for component in api mcpServer frontend; do
        local pol
        pol=$(helm get values "$RELEASE" -n "$NAMESPACE" -a 2>/dev/null \
                | python3 -c "import sys,yaml; d=yaml.safe_load(sys.stdin) or {}; print((d.get('$component') or {}).get('image',{}).get('pullPolicy') or 'IfNotPresent')" 2>/dev/null)
        info "$(printf '%-22s' "$component pullPolicy")  $pol"
      done
      ;;
    set-registry)
      local host="${1:-}"
      [[ -z "$host" ]] && die "usage: keosctl images set-registry <host:port>"
      info "helm upgrade --reuse-values --set global.imageRegistry=$host"
      helm upgrade "$RELEASE" "$REPO_ROOT/deploy/helm/pocteo" -n "$NAMESPACE" \
        --reuse-values --wait --timeout 5m \
        --set-string "global.imageRegistry=$host" 2>&1 | tail -5
      ok "Registry set. New pods will pull from $host."
      ;;
    pull-policy)
      local policy="${1:-}"
      case "$policy" in
        Always|IfNotPresent|Never) ;;
        *) die "usage: keosctl images pull-policy <Always|IfNotPresent|Never>" ;;
      esac
      info "helm upgrade --reuse-values --set api/mcpServer/frontend.image.pullPolicy=$policy"
      helm upgrade "$RELEASE" "$REPO_ROOT/deploy/helm/pocteo" -n "$NAMESPACE" \
        --reuse-values --wait --timeout 5m \
        --set-string "api.image.pullPolicy=$policy" \
        --set-string "mcpServer.image.pullPolicy=$policy" \
        --set-string "frontend.image.pullPolicy=$policy" 2>&1 | tail -5
      ok "Pull policy set to $policy."
      ;;
    *) die "unknown action '$action' — valid: list, registry, set-registry, pull-policy" ;;
  esac
}

# ─── Subcommand: values (helm values get / set / edit / diff) ────────────────

cmd_values() {
  _check_help values "$@"
  require_namespace
  local action="${1:-get}"
  shift || true
  case "$action" in
    get|show)
      local key="${1:-}"
      if [[ -z "$key" ]]; then
        helm get values "$RELEASE" -n "$NAMESPACE" -a
      else
        helm get values "$RELEASE" -n "$NAMESPACE" -a 2>/dev/null | python3 -c "
import sys, yaml
data = yaml.safe_load(sys.stdin) or {}
key = '$key'
for part in key.split('.'):
    data = (data or {}).get(part)
print(yaml.safe_dump(data, default_flow_style=False) if data is not None else '')
" 2>/dev/null
      fi
      ;;
    set)
      local kv="${1:-}"
      [[ -z "$kv" ]] && die "usage: keosctl values set <key>=<value>"
      info "helm upgrade --reuse-values --set $kv"
      helm upgrade "$RELEASE" "$REPO_ROOT/deploy/helm/pocteo" -n "$NAMESPACE" \
        --reuse-values --wait --timeout 5m --set "$kv" 2>&1 | tail -5
      ok "Applied. 'keosctl status' to verify."
      ;;
    edit)
      local tmp
      tmp=$(mktemp --suffix=.yaml)
      helm get values "$RELEASE" -n "$NAMESPACE" -a > "$tmp"
      "${EDITOR:-vi}" "$tmp"
      info "helm upgrade --reuse-values -f $tmp"
      helm upgrade "$RELEASE" "$REPO_ROOT/deploy/helm/pocteo" -n "$NAMESPACE" \
        --reuse-values --wait --timeout 5m -f "$tmp" 2>&1 | tail -5
      rm -f "$tmp"
      ok "Edits applied."
      ;;
    diff)
      diff -u \
        <(helm show values "$REPO_ROOT/deploy/helm/pocteo" 2>/dev/null) \
        <(helm get values "$RELEASE" -n "$NAMESPACE" 2>/dev/null) || true
      ;;
    *) die "unknown action '$action' — valid: get, set, edit, diff" ;;
  esac
}

# ─── Subcommand: policy (OPA matrix show / test) ─────────────────────────────

cmd_policy() {
  _check_help policy "$@"
  require_namespace
  local action="${1:-show}"
  shift || true
  case "$action" in
    show)
      # OPA's image is distroless (no `cat`). Read the policy from its
      # ConfigMap instead — that's where the chart loads it from. The
      # chart names it after the release pattern; try the common ones.
      local cm=""
      for try in opa-policy "${RELEASE}-opa-policy" opa-policies "${RELEASE}-opa-policies"; do
        if kc get cm "$try" >/dev/null 2>&1; then
          cm="$try"; break
        fi
      done
      [[ -z "$cm" ]] && cm="$(kc get cm -o name 2>/dev/null | grep -iE 'opa|polic' | head -1 | sed 's|configmap/||')"
      [[ -z "$cm" ]] && die "OPA policy ConfigMap not found — try 'kubectl get cm -n $NAMESPACE'"
      kc get cm "$cm" -o jsonpath='{.data.agent\.rego}'
      echo
      ;;
    test)
      local act="${1:-}" sev="${2:-}" ns="${3:-}" mode="${4:-}"
      [[ -z "$act" || -z "$sev" || -z "$ns" || -z "$mode" ]] && \
        die "usage: keosctl policy test <action> <severity> <namespace> <mode>"
      # OPA's image is distroless — no curl. Call OPA from the api pod
      # via cluster DNS (svc/opa:8181).
      local api_pod="$(pod_for api)"
      [[ -z "$api_pod" ]] && die "api pod not found (needed to reach OPA)"
      heading "OPA decision"
      info "Input  action=$act  severity=$sev  ns=$ns  mode=$mode"
      kc exec "$api_pod" -- curl -sf -X POST http://opa:8181/v1/data/agent/authz \
        -H "Content-Type: application/json" \
        -d "{\"input\":{\"action\":\"$act\",\"severity\":\"$sev\",\"agent_mode\":\"$mode\",\"target\":{\"namespace\":\"$ns\",\"kind\":\"Pod\",\"name\":\"test\"}}}" \
        2>/dev/null | python3 -m json.tool || \
        warn "OPA call failed — pod logs may show why: keosctl logs opa --tail 30"
      ;;
    *) die "unknown action '$action' — valid: show, test" ;;
  esac
}

# ─── Subcommand: runbooks (corpus list / show) ───────────────────────────────

cmd_runbooks() {
  _check_help runbooks "$@"
  require_namespace
  local action="${1:-list}"
  shift || true
  local api_pod="$(pod_for api)"
  [[ -z "$api_pod" ]] && die "api pod not found"
  case "$action" in
    list|ls)
      heading "Runbook corpus"
      # Recurse so the security/ subdir (Phase 21) shows alongside the
      # top-level SRE runbooks; print paths relative to the runbooks root.
      kc exec "$api_pod" -- sh -c 'cd /app/agent/runbooks && find . -name "*.md" | sed "s|^\./||" | sort' 2>/dev/null \
        | awk '{printf "  • %s\n", $1}'
      local pts
      pts=$(kc exec "$api_pod" -- curl -sf http://qdrant:6333/collections/runbooks 2>/dev/null \
              | python3 -c "import json,sys;print(json.load(sys.stdin)['result']['points_count'])" 2>/dev/null)
      printf "\n"
      note "Qdrant 'runbooks' collection: ${pts:-?} points"
      ;;
    show|cat)
      local slug="${1:-}"
      [[ -z "$slug" ]] && die "usage: keosctl runbooks show <slug-or-filename>"
      [[ "$slug" == *.md ]] || slug="${slug}.md"
      kc exec "$api_pod" -- cat "/app/agent/runbooks/$slug" 2>&1 | head -200
      ;;
    *) die "unknown action '$action' — valid: list, show" ;;
  esac
}

# ─── Subcommand: quarantine (security containment: list / release) ───────────
# The security domain's containment tools (isolate_pod / apply_network_policy /
# quarantine_pod) apply a deny-all or deny-egress NetworkPolicy + a
# keos.pocteo/quarantine label. This command lists what's contained and
# RELEASES it — the reversible half of the containment story.
cmd_quarantine() {
  _check_help quarantine "$@"
  local action="${1:-list}"
  shift || true
  case "$action" in
    list|ls)
      heading "Quarantined / contained workloads"
      # Pods carrying the quarantine or contain label, across all namespaces.
      printf "  ${C_BOLD}Pods${C_RST}\n"
      kc_cluster get pods -A \
        -l 'keos.pocteo/quarantine=true' -o wide 2>/dev/null | sed 's/^/    /' \
        | grep -v '^    NAME' || true
      kc_cluster get pods -A \
        -l 'keos.pocteo/contain' -o wide 2>/dev/null | sed 's/^/    /' \
        | grep -v '^    NAME' || true
      printf "\n  ${C_BOLD}NetworkPolicies (keos-security-agent)${C_RST}\n"
      kc_cluster get networkpolicy -A \
        -l 'app.kubernetes.io/managed-by=keos-security-agent' \
        -o custom-columns=NS:.metadata.namespace,NAME:.metadata.name 2>/dev/null \
        | sed 's/^/    /' | grep -v '^    NS ' || note "none — nothing contained"
      printf "\n  ${C_DIM}Release one: keosctl quarantine release <pod> <namespace>${C_RST}\n"
      ;;
    release|undo)
      local pod="${1:-}" ns="${2:-}"
      [[ -z "$pod" || -z "$ns" ]] && die "usage: keosctl quarantine release <pod> <namespace>"
      heading "Releasing $ns/$pod from containment"
      # Delete the deny-all + deny-egress NetworkPolicies the tools create.
      local np_iso="keos-isolate-$pod" np_exf="keos-noexfil-$pod"
      kc_cluster delete networkpolicy "${np_iso:0:63}" -n "$ns" 2>/dev/null \
        && ok "deleted NetworkPolicy ${np_iso:0:63}" || note "no deny-all NetworkPolicy"
      kc_cluster delete networkpolicy "${np_exf:0:63}" -n "$ns" 2>/dev/null \
        && ok "deleted NetworkPolicy ${np_exf:0:63}" || note "no deny-egress NetworkPolicy"
      # Strip the labels + forensics-hold annotation (trailing - = remove).
      kc_cluster label   pod "$pod" -n "$ns" keos.pocteo/quarantine-     2>/dev/null && ok "removed quarantine label" || true
      kc_cluster label   pod "$pod" -n "$ns" keos.pocteo/contain-        2>/dev/null || true
      kc_cluster annotate pod "$pod" -n "$ns" keos.pocteo/forensics-hold- 2>/dev/null || true
      ok "released $ns/$pod"
      note "Verify: keosctl quarantine list"
      ;;
    *) die "unknown action '$action' — valid: list, release" ;;
  esac
}

# ─── Subcommand: bus (NATS subject tail / streams) ───────────────────────────

cmd_bus() {
  _check_help bus "$@"
  require_namespace
  local action="${1:-streams}"
  shift || true
  # The nats:alpine image doesn't ship the nats CLI. Use the HTTP
  # monitoring endpoint (port 8222) for read-only queries, and the API
  # pod (which DOES have nats-py + Python) for live subscriptions.
  local nats_pod="$(pod_for nats)"
  [[ -z "$nats_pod" ]] && die "nats pod not found"
  case "$action" in
    streams|list)
      # The nats:alpine image has no wget/curl. Hit the HTTP monitoring
      # endpoint from the api pod (which has curl) via cluster DNS.
      heading "JetStream streams"
      local api_pod="$(pod_for api)"
      [[ -z "$api_pod" ]] && die "api pod not found (needed to reach NATS monitoring)"
      kc exec "$api_pod" -- curl -sf "http://nats:8222/jsz?streams=1" 2>/dev/null \
        | python3 -c "
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    print('  ${C_DIM}(JetStream not active or monitoring port not exposed)${C_RST}'); sys.exit(0)
accounts = data.get('account_details') or []
streams = []
for acc in accounts:
    streams.extend(acc.get('stream_detail') or [])
if not streams:
    print('  ${C_DIM}No streams created yet.${C_RST}')
else:
    print('  ${C_BOLD}STREAM                    MESSAGES   BYTES${C_RST}')
    for s in streams:
        print(f'  {s.get(\"name\",\"?\"):<25} {s.get(\"state\",{}).get(\"messages\",0):>8}   {s.get(\"state\",{}).get(\"bytes\",0):>8}')
"
      ;;
    tail|sub|subscribe)
      local subject="${1:-infra.events.>}"
      local api_pod="$(pod_for api)"
      [[ -z "$api_pod" ]] && die "api pod not found"
      info "Subscribing to NATS '$subject' via the api pod (Ctrl-C to stop)…"
      kc exec -it "$api_pod" -- python -c "
import asyncio, nats
async def main():
    nc = await nats.connect('nats://nats:4222')
    async def cb(msg):
        print(f'[{msg.subject}] {msg.data.decode(errors=\"replace\")[:200]}', flush=True)
    await nc.subscribe('$subject', cb=cb)
    while True: await asyncio.sleep(60)
asyncio.run(main())
"
      ;;
    info)
      kc exec "$nats_pod" -- wget -qO- http://localhost:8222/varz 2>/dev/null \
        | python3 -m json.tool
      ;;
    *) die "unknown action '$action' — valid: tail, streams, info" ;;
  esac
}

