#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  keosctl — the Keos SRE Agent CLI
# ─────────────────────────────────────────────────────────────────────────────
#  One tool for the operator's whole lifecycle: install, status, logs, mode
#  flips, port-forward, model management, uninstall. Subcommands wrap the
#  underlying install.sh + install-edge.sh + kubectl + helm + ollama calls
#  with consistent flags + branded output.
#
#  Designed to be symlinked to a directory on PATH (e.g. ~/.local/bin) so
#  the colleague's daily flow is `keosctl <verb>` instead of remembering
#  paths or kubectl incantations.
#
#  Bash 4+ required. No other dependencies beyond what install.sh already
#  needs (kubectl, helm, docker, openssl, python3, curl).
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

KEOSCTL_VERSION="1.0.1"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# ─── Defaults (overridable via env + global flags) ───────────────────────────

NAMESPACE="${KEOS_NAMESPACE:-keos}"
RELEASE="${KEOS_RELEASE:-keos}"
KUBECONFIG_OVERRIDE=""

# ─── Colors ──────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
  C_RST=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'
  C_MAGENTA=$'\033[35m'
  C_CYAN=$'\033[36m'
  C_GREY=$'\033[90m'
else
  C_RST="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_BLUE=""
  C_MAGENTA="" C_CYAN="" C_GREY=""
fi

CHECK="✓"
CROSS="✗"
WARN="⚠"
ARROW="›"

# ─── Helpers ─────────────────────────────────────────────────────────────────

say()   { echo "$@"; }
ok()    { printf "  ${C_GREEN}${CHECK}${C_RST} %s\n" "$*"; }
fail()  { printf "  ${C_RED}${CROSS}${C_RST} %s\n" "$*" >&2; }
warn()  { printf "  ${C_YELLOW}${WARN}${C_RST} %s\n" "$*"; }
info()  { printf "  ${C_BLUE}${ARROW}${C_RST} %s\n" "$*"; }
note()  { printf "  ${C_DIM}%s${C_RST}\n" "$*"; }
die()   { printf "${C_RED}${CROSS}${C_RST} %s\n" "$*" >&2; exit 1; }
hr()    { printf "${C_GREY}────────────────────────────────────────────────────────────────${C_RST}\n"; }
heading(){ printf "\n${C_BOLD}${C_CYAN}%s${C_RST}\n" "$1"; hr; }

# kubectl wrapper that honors the wizard's kubeconfig + namespace.
kc() {
  local args=()
  [[ -n "$KUBECONFIG_OVERRIDE" ]] && args+=("--kubeconfig" "$KUBECONFIG_OVERRIDE")
  kubectl "${args[@]}" -n "$NAMESPACE" "$@"
}

# Same wrapper but cluster-scoped (no -n).
kc_cluster() {
  local args=()
  [[ -n "$KUBECONFIG_OVERRIDE" ]] && args+=("--kubeconfig" "$KUBECONFIG_OVERRIDE")
  kubectl "${args[@]}" "$@"
}

# Pretty-print JSON safely if python3 is available, otherwise fall back to raw.
jq_inline() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c "import sys, json; d=json.load(sys.stdin); $1"
  else
    cat
  fi
}

# Get the first pod of a Keos component (api/mcp-server/frontend/ollama/…).
pod_for() {
  kc get pod -l "app.kubernetes.io/component=$1" \
    -o jsonpath='{.items[0].metadata.name}' 2>/dev/null
}

require_namespace() {
  if ! kc_cluster get namespace "$NAMESPACE" >/dev/null 2>&1; then
    die "namespace '$NAMESPACE' not found — is Keos installed?  Run 'keosctl install' first."
  fi
}

# Get the API service URL accessible from inside the cluster — used by
# `events`, `run`, `audit` etc. which call FastAPI via kubectl exec.
api_curl() {
  local api_pod token path="$1"
  shift
  api_pod="$(pod_for api)"
  [[ -z "$api_pod" ]] && die "api pod not found"
  if [[ -f "$HOME/.keos-token" ]]; then
    token="$(cat "$HOME/.keos-token")"
  else
    token="$(kc get secret keos-pocteo-auth -o jsonpath='{.data.SHP_API_TOKEN}' 2>/dev/null | base64 -d)"
  fi
  kc exec "$api_pod" -- curl -sf \
    -H "Authorization: Bearer $token" \
    "http://localhost:8000${path}" "$@"
}

# ─── Subcommand: install ─────────────────────────────────────────────────────

cmd_install() {
  local interactive=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --headless|--non-interactive) interactive=0; shift ;;
      *) break ;;
    esac
  done
  if [[ $interactive -eq 1 ]]; then
    [[ -r "$SCRIPT_DIR/install.sh" ]] || die "install.sh not found at $SCRIPT_DIR"
    exec bash "$SCRIPT_DIR/install.sh" "$@"
  else
    [[ -r "$SCRIPT_DIR/install-edge.sh" ]] || die "install-edge.sh not found at $SCRIPT_DIR"
    exec bash "$SCRIPT_DIR/install-edge.sh" "$@"
  fi
}

# ─── Subcommand: uninstall ───────────────────────────────────────────────────

cmd_uninstall() {
  local keep_pvcs=0 keep_ns=0 yes=0 force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --keep-pvcs)      keep_pvcs=1; shift ;;
      --keep-namespace) keep_ns=1; shift ;;
      --yes|-y)         yes=1; shift ;;
      --force|-f)       force=1; yes=1; shift ;;
      *) die "unknown arg: $1" ;;
    esac
  done

  if ! kc_cluster get namespace "$NAMESPACE" >/dev/null 2>&1; then
    warn "namespace $NAMESPACE doesn't exist — nothing to uninstall"
    return 0
  fi

  if [[ $yes -eq 0 ]]; then
    heading "Uninstall Keos"
    info "Release       $RELEASE"
    info "Namespace     $NAMESPACE"
    info "Keep PVCs?    $([[ $keep_pvcs -eq 1 ]] && echo yes || echo no)"
    info "Keep ns?      $([[ $keep_ns -eq 1 ]] && echo yes || echo no)"
    printf "\n  Continue? [y/N] "
    read -r answer || answer=""
    [[ "$answer" =~ ^[Yy] ]] || { say "Aborted."; return 0; }
  fi

  say "Removing Helm release '$RELEASE'…"
  helm uninstall "$RELEASE" -n "$NAMESPACE" 2>&1 | tail -3 || true
  if [[ $keep_pvcs -eq 0 ]]; then
    say "Removing PVCs…"
    kc delete pvc --all --ignore-not-found 2>&1 | tail -3 || true
  fi
  if [[ $keep_ns -eq 0 ]]; then
    say "Deleting namespace '$NAMESPACE'…"
    kc_cluster delete namespace "$NAMESPACE" --ignore-not-found --wait=false 2>&1 | tail -3 || true
  fi
  ok "Uninstall complete"
}

# ─── Subcommand: status ──────────────────────────────────────────────────────

cmd_status() {
  local watch=0 as_json=0 interval=2
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -w|--watch) watch=1; shift ;;
      --interval) interval="$2"; shift 2 ;;
      --json) as_json=1; shift ;;
      *) die "unknown arg: $1" ;;
    esac
  done
  if [[ $as_json -eq 1 ]]; then
    require_namespace
    local mode
    mode=$(kc_cluster get agentmode default -o jsonpath='{.spec.mode}' 2>/dev/null || echo '?')
    kc get pods -o json 2>/dev/null | python3 -c "
import json, sys
pods = json.load(sys.stdin)['items']
out = {
  'namespace': '${NAMESPACE}',
  'release': '${RELEASE}',
  'mode': '${mode}',
  'pods': [{
    'name': p['metadata']['name'],
    'phase': p['status'].get('phase'),
    'ready': all(c.get('ready', False) for c in p['status'].get('containerStatuses', []) or [{}]),
  } for p in pods],
  'pods_ready': sum(1 for p in pods if all(c.get('ready', False) for c in p['status'].get('containerStatuses', []) or [{}])),
  'pods_total': len(pods),
}
print(json.dumps(out, indent=2))
"
    return 0
  fi
  if [[ $watch -eq 1 ]]; then
    while true; do
      clear
      _print_status
      printf "\n${C_DIM}Refreshing every %ss — Ctrl-C to stop${C_RST}\n" "$interval"
      sleep "$interval"
    done
  else
    _print_status
  fi
}

_print_status() {
  require_namespace
  heading "Keos status"

  # Helm release.
  local chart status_word
  if chart=$(helm list -n "$NAMESPACE" -f "^${RELEASE}\$" -o json 2>/dev/null | \
             jq_inline 'print(d[0]["chart"]) if d else exit(1)' 2>/dev/null); then
    status_word=$(helm list -n "$NAMESPACE" -f "^${RELEASE}\$" -o json 2>/dev/null | \
                   jq_inline 'print(d[0]["status"]) if d else print("?")')
    info "Release       ${C_BOLD}$chart${C_RST}  ${C_DIM}($status_word)${C_RST}"
  else
    fail "Helm release '$RELEASE' not found"
    return 1
  fi
  info "Namespace     $NAMESPACE"

  # Agent mode CR.
  local mode
  mode=$(kc_cluster get agentmode default -o jsonpath='{.spec.mode}' 2>/dev/null || echo '?')
  local mode_color="$C_GREEN"
  [[ "$mode" == "active" ]] && mode_color="$C_YELLOW"
  [[ "$mode" == "frozen" ]] && mode_color="$C_BLUE"
  printf "  ${C_BLUE}${ARROW}${C_RST} Agent mode    ${mode_color}${C_BOLD}%s${C_RST}\n" "$mode"

  # Pod summary.
  printf "\n${C_BOLD}Pods${C_RST}\n"
  local total=0 ready=0
  while IFS= read -r line; do
    local name="$(echo "$line" | awk '{print $1}')"
    local ready_col="$(echo "$line" | awk '{print $2}')"
    local phase="$(echo "$line" | awk '{print $3}')"
    local age="$(echo "$line" | awk '{print $5}')"
    total=$((total + 1))
    local color="$C_RED" mark="$CROSS"
    if [[ "$phase" == "Running" && "$ready_col" =~ ^[1-9].*/[1-9] ]]; then
      color="$C_GREEN" mark="$CHECK"
      ready=$((ready + 1))
    elif [[ "$phase" == "Running" ]]; then
      color="$C_YELLOW" mark="$WARN"
    fi
    printf "  ${color}%s${C_RST} %-42s ${C_DIM}%-10s %s${C_RST}\n" "$mark" "$name" "$ready_col" "$age"
  done < <(kc get pods --no-headers 2>/dev/null)
  printf "  ${C_DIM}%d/%d pods Ready${C_RST}\n" "$ready" "$total"

  # Hints.
  printf "\n${C_BOLD}Access${C_RST}\n"
  note "Open the SPA:        keosctl ui"
  note "Get the token:       keosctl token"
  note "Tail the agent:      keosctl logs api -f"
  printf "\n"
}

# ─── Subcommand: doctor ──────────────────────────────────────────────────────

cmd_doctor() {
  require_namespace
  heading "Keos doctor"
  local fails=0

  if helm list -n "$NAMESPACE" -f "^${RELEASE}\$" -q 2>/dev/null | grep -q .; then
    ok "Helm release deployed"
  else
    fail "Helm release '$RELEASE' not found"
    fails=$((fails + 1))
  fi

  for component in api mcp-server frontend ollama qdrant nats opa caddy; do
    local phase
    phase=$(kc get pod -l "app.kubernetes.io/component=$component" \
              -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo '')
    if [[ "$phase" == "Running" ]]; then
      local ready
      ready=$(kc get pod -l "app.kubernetes.io/component=$component" \
                -o jsonpath='{.items[0].status.containerStatuses[0].ready}' 2>/dev/null)
      if [[ "$ready" == "true" ]]; then
        ok "$(printf '%-15s' "$component")  Running (ready)"
      else
        warn "$(printf '%-15s' "$component")  Running but not Ready"
        fails=$((fails + 1))
      fi
    elif [[ -z "$phase" ]]; then
      fail "$(printf '%-15s' "$component")  pod missing"
      fails=$((fails + 1))
    else
      fail "$(printf '%-15s' "$component")  $phase"
      fails=$((fails + 1))
    fi
  done

  local mode
  mode=$(kc_cluster get agentmode default -o jsonpath='{.spec.mode}' 2>/dev/null || echo '')
  if [[ -n "$mode" ]]; then
    ok "AgentMode CR present (mode=$mode)"
  else
    fail "AgentMode CR missing — agent won't know what to do"
    fails=$((fails + 1))
  fi

  # Ollama models — are the chat + embed models loaded?
  local ollama_pod
  ollama_pod="$(pod_for ollama)"
  if [[ -n "$ollama_pod" ]]; then
    local model_count
    model_count=$(kc exec "$ollama_pod" -- ollama list 2>/dev/null | tail -n +2 | wc -l)
    if (( model_count >= 2 )); then
      ok "$(printf '%-15s' 'ollama models')  $model_count present"
    elif (( model_count >= 1 )); then
      warn "$(printf '%-15s' 'ollama models')  only $model_count loaded (need chat + embed)"
      fails=$((fails + 1))
    else
      fail "$(printf '%-15s' 'ollama models')  none loaded — run 'keosctl models pull qwen2.5:3b-instruct-q4_K_M'"
      fails=$((fails + 1))
    fi
  fi

  # Qdrant runbook count.
  local api_pod
  api_pod="$(pod_for api)"
  if [[ -n "$api_pod" ]]; then
    local pts
    pts=$(kc exec "$api_pod" -- curl -sf http://qdrant:6333/collections/runbooks 2>/dev/null | \
           jq_inline 'print(d["result"]["points_count"])' 2>/dev/null || echo '?')
    if [[ "$pts" =~ ^[1-9] ]]; then
      ok "$(printf '%-15s' 'runbook corpus')  $pts points in Qdrant"
    else
      warn "$(printf '%-15s' 'runbook corpus')  no points found — run 'keosctl seed'"
      fails=$((fails + 1))
    fi
  fi

  printf "\n"
  if [[ $fails -eq 0 ]]; then
    printf "  ${C_GREEN}${C_BOLD}All checks passed.${C_RST}\n"
    return 0
  else
    printf "  ${C_YELLOW}${C_BOLD}%d check(s) failed.${C_RST}  Use 'keosctl logs <component>' for details.\n" "$fails"
    return 1
  fi
}

# ─── Subcommand: mode ────────────────────────────────────────────────────────

cmd_mode() {
  local new_mode="${1:-}"
  if [[ -z "$new_mode" ]]; then
    # No arg: print the current mode.
    local mode
    mode=$(kc_cluster get agentmode default -o jsonpath='{.spec.mode}' 2>/dev/null || echo '')
    if [[ -z "$mode" ]]; then
      die "AgentMode CR not found"
    fi
    say "$mode"
    return 0
  fi
  case "$new_mode" in
    observe-only|active|frozen) ;;
    *) die "invalid mode '$new_mode' — valid: observe-only / active / frozen" ;;
  esac
  if [[ "$new_mode" == "active" ]]; then
    printf "  ${C_YELLOW}${WARN}${C_RST} Switching to ${C_BOLD}active${C_RST} — agent will mutate the cluster.\n"
    printf "  Continue? [y/N] "
    read -r answer || answer=""
    [[ "$answer" =~ ^[Yy] ]] || { say "Aborted."; return 0; }
  fi
  kc_cluster patch agentmode default --type=merge \
    -p "{\"spec\":{\"mode\":\"$new_mode\"}}" >/dev/null
  ok "Agent mode set to ${C_BOLD}$new_mode${C_RST}"
}

# ─── Subcommand: logs ────────────────────────────────────────────────────────

cmd_logs() {
  require_namespace
  local component="${1:-}"
  shift || true
  if [[ -z "$component" || "$component" == "-h" || "$component" == "--help" ]]; then
    say "Usage: keosctl logs <component> [-f|--follow] [--tail N]"
    say ""
    say "Components:"
    say "  api          The Keos FastAPI + LangGraph agent"
    say "  mcp-server   The MCP action tool server"
    say "  frontend     The React SPA (nginx)"
    say "  caddy        The HTTP/WS reverse proxy"
    say "  ollama       The local LLM runtime"
    say "  qdrant       The RAG vector store"
    say "  nats         The event bus"
    say "  opa          The policy engine"
    return 0
  fi
  case "$component" in
    api|mcp-server|frontend|ollama|qdrant|nats|opa|caddy) ;;
    *) die "unknown component '$component' — try 'keosctl logs' to list components" ;;
  esac
  kc logs -l "app.kubernetes.io/component=$component" --tail=100 "$@"
}

# ─── Subcommand: ui ──────────────────────────────────────────────────────────

cmd_ui() {
  require_namespace
  local port=8080
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="$2"; shift 2 ;;
      --no-open) NO_OPEN=1; shift ;;
      *) die "unknown arg: $1" ;;
    esac
  done

  local token=""
  [[ -f "$HOME/.keos-token" ]] && token="$(cat "$HOME/.keos-token")"
  if [[ -z "$token" ]]; then
    token="$(kc get secret keos-pocteo-auth -o jsonpath='{.data.SHP_API_TOKEN}' 2>/dev/null | base64 -d 2>/dev/null)" || true
  fi

  heading "Opening Keos SPA"
  info "URL           ${C_CYAN}http://localhost:$port${C_RST}"
  if [[ -n "$token" ]]; then
    info "Token         ${C_GREEN}${C_BOLD}$token${C_RST}"
    note "(paste this into the login screen; also cached at ~/.keos-token)"
  else
    note "Token not found yet — run 'keosctl token' once pods are Ready"
  fi
  printf "\n"
  note "Port-forwarding svc/pocteo on :$port — press Ctrl-C to stop."
  printf "\n"

  # Try to open the browser after a short delay (so the forward is up).
  if [[ "${NO_OPEN:-}" != "1" ]]; then
    if command -v xdg-open >/dev/null; then
      (sleep 2 && xdg-open "http://localhost:$port" >/dev/null 2>&1) &
    elif command -v open >/dev/null; then
      (sleep 2 && open "http://localhost:$port" >/dev/null 2>&1) &
    elif command -v powershell.exe >/dev/null; then
      # WSL → Windows browser
      (sleep 2 && powershell.exe Start-Process "http://localhost:$port" >/dev/null 2>&1) &
    fi
  fi

  exec kc port-forward svc/pocteo "$port:80" --address=0.0.0.0
}

# ─── Subcommand: token ───────────────────────────────────────────────────────

cmd_token() {
  if [[ -f "$HOME/.keos-token" ]]; then
    cat "$HOME/.keos-token"; echo
    return 0
  fi
  require_namespace
  local t
  t="$(kc get secret keos-pocteo-auth -o jsonpath='{.data.SHP_API_TOKEN}' 2>/dev/null | base64 -d 2>/dev/null)"
  if [[ -n "$t" ]]; then
    echo "$t"
    # Cache it for next time.
    umask 0077
    echo "$t" > "$HOME/.keos-token"
  else
    die "token not found — is the API pod Ready?"
  fi
}

# ─── Subcommand: seed ────────────────────────────────────────────────────────

cmd_seed() {
  require_namespace
  local api_pod
  api_pod="$(pod_for api)"
  [[ -z "$api_pod" ]] && die "api pod not found"
  say "Seeding runbooks into Qdrant…"
  kc exec "$api_pod" -- python -m agent.seed_rag
  ok "Done"
}

# ─── Subcommand: models ──────────────────────────────────────────────────────

cmd_models() {
  require_namespace
  local action="${1:-list}"
  shift || true
  local ollama_pod
  ollama_pod="$(pod_for ollama)"
  [[ -z "$ollama_pod" ]] && die "ollama pod not found"
  case "$action" in
    list)
      kc exec "$ollama_pod" -- ollama list
      ;;
    pull)
      local model="${1:-}"
      [[ -z "$model" ]] && die "usage: keosctl models pull <model>"
      say "Pulling $model… (this can take several minutes)"
      kc exec "$ollama_pod" -- ollama pull "$model"
      ok "Pulled $model"
      ;;
    rm)
      local model="${1:-}"
      [[ -z "$model" ]] && die "usage: keosctl models rm <model>"
      kc exec "$ollama_pod" -- ollama rm "$model"
      ok "Removed $model"
      ;;
    show)
      local model="${1:-}"
      [[ -z "$model" ]] && die "usage: keosctl models show <model>"
      kc exec "$ollama_pod" -- ollama show "$model"
      ;;
    *) die "unknown action '$action' — valid: list / pull / rm / show" ;;
  esac
}

# ─── Subcommand: context ─────────────────────────────────────────────────────

cmd_context() {
  kc_cluster config current-context
}

# ─── Subcommand: version ─────────────────────────────────────────────────────

cmd_version() {
  printf "${C_BOLD}keosctl${C_RST}      v%s\n" "$KEOSCTL_VERSION"
  local chart
  if chart=$(helm list -n "$NAMESPACE" -f "^${RELEASE}\$" -o json 2>/dev/null | \
             jq_inline 'print(d[0]["chart"]) if d else exit(1)' 2>/dev/null); then
    printf "Helm chart   %s\n" "$chart"
  else
    printf "Helm chart   ${C_DIM}(not installed in this namespace)${C_RST}\n"
  fi
  printf "Repo root    %s\n" "$REPO_ROOT"
  printf "Bash         %s\n" "${BASH_VERSION}"
}

# ─── Subcommand: link (symlink to ~/.local/bin) ──────────────────────────────

cmd_link() {
  local target="${1:-$HOME/.local/bin/keosctl}"
  mkdir -p "$(dirname "$target")"
  ln -sfn "$SCRIPT_DIR/keosctl" "$target"
  ok "keosctl linked at $target"
  if ! command -v keosctl >/dev/null 2>&1; then
    note "Add this to your shell profile if 'keosctl' isn't on PATH yet:"
    note "  export PATH=\"\$HOME/.local/bin:\$PATH\""
  else
    note "Already on PATH — try: keosctl status"
  fi
}

# ─── Subcommand: events / incidents ──────────────────────────────────────────

cmd_events() {
  require_namespace
  local limit=10 watch=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--limit) limit="$2"; shift 2 ;;
      -w|--watch) watch=1; shift ;;
      *) die "unknown arg: $1" ;;
    esac
  done
  _render_events() {
    heading "Recent incidents"
    api_curl "/api/incidents?limit=$limit" 2>/dev/null | python3 -c "
import json, sys
raw = sys.stdin.read() or '[]'
try:
    data = json.loads(raw)
except Exception:
    print('  ${C_RED}✗${C_RST} could not parse API response'); sys.exit(0)
items = data if isinstance(data, list) else data.get('items', [])
if not items:
    print('  ${C_DIM}No incidents yet — try \"keosctl run lib-memory-leak\".${C_RST}')
else:
    for i in items[:$limit]:
        ts = (i.get('triage_ts') or i.get('ts') or '?')[:19]
        rule = i.get('rule_id') or '?'
        outcome = i.get('outcome') or '?'
        tool = (i.get('proposed_action') or {}).get('tool') or '?'
        color = '${C_GREEN}' if outcome == 'healed' else '${C_YELLOW}' if outcome == 'escalated' else '${C_RED}' if outcome == 'failed' else '${C_DIM}'
        print(f'  {color}●${C_RST}  {ts:<20} {rule:<28} {tool:<18} {color}{outcome}${C_RST}')
" 2>/dev/null || warn "API unreachable — is the api pod Ready?"
  }
  if [[ $watch -eq 1 ]]; then
    while true; do clear; _render_events; printf "\n${C_DIM}Refreshing every 3s — Ctrl-C to stop${C_RST}\n"; sleep 3; done
  else
    _render_events
  fi
}

# ─── Subcommand: usecases ────────────────────────────────────────────────────

cmd_usecases() {
  require_namespace
  local action="${1:-list}"
  shift || true
  case "$action" in
    list)
      heading "Available use cases"
      api_curl "/api/usecases" 2>/dev/null | python3 -c "
import json, sys
data = json.load(sys.stdin)
items = data if isinstance(data, list) else data.get('items', [])
for u in items:
    slug = u.get('slug') or u.get('id') or '?'
    title = u.get('title_en') or u.get('title') or '?'
    print(f'  ${C_CYAN}{slug:<28}${C_RST}  {title}')
" 2>/dev/null || warn "Could not fetch use cases (API down?)"
      ;;
    show)
      local slug="${1:-}"; [[ -z "$slug" ]] && die "usage: keosctl usecases show <slug>"
      api_curl "/api/usecases/$slug" | python3 -m json.tool
      ;;
    *) die "unknown action '$action' — valid: list, show" ;;
  esac
}

# ─── Subcommand: run (trigger a use case) ────────────────────────────────────

cmd_run() {
  require_namespace
  local slug="${1:-}"
  [[ -z "$slug" ]] && die "usage: keosctl run <use-case-slug>  (try 'keosctl usecases list')"
  heading "Running use case '$slug'"
  local resp
  resp="$(api_curl "/api/usecases/$slug/run" -X POST 2>&1)" || die "API call failed: $resp"
  echo "$resp" | python3 -c "
import json, sys
data = json.loads(sys.stdin.read() or '{}')
iid = data.get('incident_id') or '?'
print(f'  ${C_GREEN}✓${C_RST} Incident id: ${C_BOLD}{iid}${C_RST}')
print('  Watch live: ${C_CYAN}keosctl events -w${C_RST}')
print('  Open SPA:   ${C_CYAN}keosctl ui${C_RST}  (Pipeline tab)')
" 2>/dev/null || echo "$resp"
}

# ─── Subcommand: restart ─────────────────────────────────────────────────────

cmd_restart() {
  require_namespace
  local component="${1:-}"
  [[ -z "$component" ]] && die "usage: keosctl restart <component>  (api / mcp-server / frontend / caddy)"
  case "$component" in
    api|mcp-server|frontend|caddy|opa)
      kc rollout restart "deploy/$component"
      ok "Restarted deployment/$component"
      ;;
    ollama|qdrant|nats)
      kc delete pod -l "app.kubernetes.io/component=$component"
      ok "Recycled $component pod (StatefulSet will respawn it)"
      ;;
    *) die "unknown component '$component'" ;;
  esac
}

# ─── Subcommand: shell ───────────────────────────────────────────────────────

cmd_shell() {
  require_namespace
  local component="${1:-api}"
  shift || true
  local pod="$(pod_for "$component")"
  [[ -z "$pod" ]] && die "no pod for component '$component'"
  # Try bash, fall back to sh.
  kc exec -it "$pod" -- bash 2>/dev/null || kc exec -it "$pod" -- sh
}

# ─── Subcommand: describe ────────────────────────────────────────────────────

cmd_describe() {
  require_namespace
  local component="${1:-}"
  [[ -z "$component" ]] && die "usage: keosctl describe <component>"
  local pod="$(pod_for "$component")"
  [[ -z "$pod" ]] && die "no pod for component '$component'"
  kc describe pod "$pod"
}

# ─── Subcommand: port-forward ────────────────────────────────────────────────

cmd_portforward() {
  require_namespace
  local component="${1:-}" port="${2:-}"
  [[ -z "$component" || -z "$port" ]] && die "usage: keosctl port-forward <component> <local-port>"
  local target_port
  case "$component" in
    api)        target_port=8000 ;;
    mcp-server) target_port=8090 ;;
    frontend)   target_port=8080 ;;
    caddy|pocteo) component=pocteo; target_port=80 ;;
    ollama)     target_port=11434 ;;
    qdrant)     target_port=6333 ;;
    nats)       target_port=4222 ;;
    opa)        target_port=8181 ;;
    *) die "unknown component '$component'" ;;
  esac
  info "Forwarding svc/$component :$target_port → localhost:$port"
  exec kc port-forward "svc/$component" "$port:$target_port"
}

# ─── Subcommand: upgrade ─────────────────────────────────────────────────────

cmd_upgrade() {
  local chart_version=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --chart-version) chart_version="$2"; shift 2 ;;
      *) die "unknown arg: $1" ;;
    esac
  done
  require_namespace
  heading "Upgrading Keos"
  local args=(upgrade "$RELEASE" "$REPO_ROOT/deploy/helm/pocteo"
              -n "$NAMESPACE" --reuse-values --wait --timeout 5m)
  if [[ -n "$chart_version" ]]; then
    args=(upgrade "$RELEASE" "oci://ghcr.io/pocteo-platform/charts/pocteo"
          --version "$chart_version" -n "$NAMESPACE" --reuse-values --wait --timeout 5m)
  fi
  helm "${args[@]}" 2>&1 | tail -8
  ok "Upgrade complete. Run 'keosctl status' to verify."
}

# ─── Subcommand: audit ───────────────────────────────────────────────────────

cmd_audit() {
  require_namespace
  local action="${1:-tail}"
  shift || true
  local api_pod="$(pod_for api)"
  [[ -z "$api_pod" ]] && die "api pod not found"
  case "$action" in
    tail)
      local n=20
      [[ "${1:-}" == "-n" || "${1:-}" == "--lines" ]] && { n="$2"; shift 2; }
      kc exec "$api_pod" -- tail -n "$n" /app/audit.log 2>/dev/null \
        || warn "audit.log not found yet (no incidents recorded?)"
      ;;
    verify)
      kc exec "$api_pod" -- python -m agent.audit --verify 2>&1 | tail -10
      ;;
    *) die "unknown action '$action' — valid: tail, verify" ;;
  esac
}

# ─── Subcommand: completion ──────────────────────────────────────────────────

cmd_completion() {
  local shell_kind="${1:-bash}"
  case "$shell_kind" in
    bash)
      cat <<'COMPLETION'
# bash completion for keosctl. Source from .bashrc:
#   eval "$(keosctl completion bash)"
_keosctl_complete() {
  local cur prev cmds
  COMPREPLY=()
  cur="${COMP_WORDS[COMP_CWORD]}"
  prev="${COMP_WORDS[COMP_CWORD-1]}"
  cmds="install uninstall link status doctor mode logs ui token seed models
        events usecases run restart shell describe port-forward upgrade
        audit completion context version help"
  case "$prev" in
    keosctl)        COMPREPLY=( $(compgen -W "$cmds" -- "$cur") ) ;;
    logs|restart|shell|describe|port-forward)
      COMPREPLY=( $(compgen -W "api mcp-server frontend caddy ollama qdrant nats opa" -- "$cur") ) ;;
    mode)           COMPREPLY=( $(compgen -W "observe-only active frozen" -- "$cur") ) ;;
    models)         COMPREPLY=( $(compgen -W "list pull rm show" -- "$cur") ) ;;
    audit)          COMPREPLY=( $(compgen -W "tail verify" -- "$cur") ) ;;
    completion)     COMPREPLY=( $(compgen -W "bash zsh fish" -- "$cur") ) ;;
    usecases)       COMPREPLY=( $(compgen -W "list show" -- "$cur") ) ;;
  esac
}
complete -F _keosctl_complete keosctl
COMPLETION
      ;;
    zsh)
      cat <<'COMPLETION'
# zsh completion for keosctl. Source from .zshrc:
#   eval "$(keosctl completion zsh)"
_keosctl() {
  local -a cmds
  cmds=(install uninstall link status doctor mode logs ui token seed models
        events usecases run restart shell describe port-forward upgrade
        audit completion context version help)
  if (( CURRENT == 2 )); then
    _describe 'command' cmds
  fi
}
compdef _keosctl keosctl
COMPLETION
      ;;
    fish)
      cat <<'COMPLETION'
# fish completion for keosctl. Save as ~/.config/fish/completions/keosctl.fish
complete -c keosctl -f
for cmd in install uninstall link status doctor mode logs ui token seed models events usecases run restart shell describe port-forward upgrade audit completion context version help
  complete -c keosctl -n "__fish_use_subcommand" -a $cmd
end
COMPLETION
      ;;
    *) die "unsupported shell '$shell_kind' — valid: bash, zsh, fish" ;;
  esac
}

# ─── Subcommand: help ────────────────────────────────────────────────────────

cmd_help() {
  printf "${C_BOLD}${C_CYAN}"
  cat <<'EOF'
       ██╗  ██╗███████╗ ██████╗ ███████╗
       ██║ ██╔╝██╔════╝██╔═══██╗██╔════╝
       █████╔╝ █████╗  ██║   ██║███████╗
       ██╔═██╗ ██╔══╝  ██║   ██║╚════██║
       ██║  ██╗███████╗╚██████╔╝███████║
       ╚═╝  ╚═╝╚══════╝ ╚═════╝ ╚══════╝
EOF
  printf "${C_RST}\n"
  printf "       ${C_BOLD}keosctl v%s${C_RST} ${C_DIM}— Autonomous SRE Agent CLI · by Pocteo Platform${C_RST}\n\n" "$KEOSCTL_VERSION"

  printf "${C_BOLD}USAGE${C_RST}\n"
  printf "  keosctl <command> [options]\n\n"

  printf "${C_BOLD}INSTALL + LIFECYCLE${C_RST}\n"
  printf "  ${C_CYAN}install${C_RST}                       Interactive 6-step wizard ${C_DIM}(recommended)${C_RST}\n"
  printf "  ${C_CYAN}install --headless${C_RST} [flags]    Non-interactive install ${C_DIM}(CI / scripted)${C_RST}\n"
  printf "  ${C_CYAN}uninstall${C_RST} [--keep-pvcs]       Remove the Keos release\n"
  printf "  ${C_CYAN}link${C_RST} [path]                   Symlink keosctl to a PATH dir ${C_DIM}(default ~/.local/bin)${C_RST}\n\n"

  printf "${C_BOLD}OPERATIONS${C_RST}\n"
  printf "  ${C_CYAN}status${C_RST} [--watch] [--json]     Release + pods + agent mode summary\n"
  printf "  ${C_CYAN}doctor${C_RST}                        Health check across every component\n"
  printf "  ${C_CYAN}mode${C_RST} [obs|active|frozen]      Print or set the agent mode\n"
  printf "  ${C_CYAN}logs${C_RST} <component> [-f]         Tail pod logs ${C_DIM}(api/mcp-server/frontend/…)${C_RST}\n"
  printf "  ${C_CYAN}ui${C_RST} [--port N]                 Port-forward + open the SPA in your browser\n"
  printf "  ${C_CYAN}token${C_RST}                         Print the bearer token\n"
  printf "  ${C_CYAN}restart${C_RST} <component>           Rollout restart a component\n"
  printf "  ${C_CYAN}shell${C_RST} <component>             Interactive bash/sh inside a pod\n"
  printf "  ${C_CYAN}describe${C_RST} <component>          kubectl describe of a Keos pod\n"
  printf "  ${C_CYAN}port-forward${C_RST} <component> <p>  Generic kubectl port-forward\n"
  printf "  ${C_CYAN}upgrade${C_RST} [--chart-version v]   helm upgrade the Keos release\n\n"

  printf "${C_BOLD}AGENT${C_RST}\n"
  printf "  ${C_CYAN}events${C_RST} [-n N] [--watch]       List recent incidents (colored by outcome)\n"
  printf "  ${C_CYAN}usecases${C_RST} list|show            List or show use case definitions\n"
  printf "  ${C_CYAN}run${C_RST} <use-case-slug>           Trigger a use case end-to-end\n"
  printf "  ${C_CYAN}audit${C_RST} tail [-n N]             Tail the HMAC-signed audit log\n"
  printf "  ${C_CYAN}audit${C_RST} verify                  Verify the HMAC chain integrity\n\n"

  printf "${C_BOLD}DATA${C_RST}\n"
  printf "  ${C_CYAN}seed${C_RST}                          Re-seed the runbook corpus into Qdrant\n"
  printf "  ${C_CYAN}models${C_RST} list                   List installed LLM models\n"
  printf "  ${C_CYAN}models${C_RST} pull <model>           Pull a new LLM into Ollama\n"
  printf "  ${C_CYAN}models${C_RST} rm <model>             Remove an LLM\n\n"

  printf "${C_BOLD}MISC${C_RST}\n"
  printf "  ${C_CYAN}context${C_RST}                       Show the kubectl context Keos is in\n"
  printf "  ${C_CYAN}version${C_RST}                       Print versions (CLI + chart + agent)\n"
  printf "  ${C_CYAN}completion${C_RST} <bash|zsh|fish>    Generate shell completion script\n"
  printf "  ${C_CYAN}help${C_RST}                          Show this message\n\n"

  printf "${C_BOLD}GLOBAL OPTIONS${C_RST}\n"
  printf "  ${C_DIM}-n, --namespace <ns>${C_RST}          Override namespace (default: keos)\n"
  printf "  ${C_DIM}-r, --release <name>${C_RST}          Override release name (default: keos)\n"
  printf "  ${C_DIM}    --kubeconfig <path>${C_RST}       Override kubeconfig\n"
  printf "  ${C_DIM}    --no-color${C_RST}               Disable ANSI colors\n"
  printf "  ${C_DIM}-h, --help${C_RST}                   Show this help\n\n"

  printf "${C_BOLD}EXAMPLES${C_RST}\n"
  printf "  ${C_DIM}# First install — interactive wizard${C_RST}\n"
  printf "  keosctl install\n\n"
  printf "  ${C_DIM}# Daily ops${C_RST}\n"
  printf "  keosctl status                           ${C_DIM}# how's everything?${C_RST}\n"
  printf "  keosctl mode active                      ${C_DIM}# let the agent take action${C_RST}\n"
  printf "  keosctl logs api -f                      ${C_DIM}# tail the API pod${C_RST}\n"
  printf "  keosctl ui                               ${C_DIM}# opens http://localhost:8080${C_RST}\n"
  printf "  keosctl token                            ${C_DIM}# print the bearer token${C_RST}\n\n"
  printf "  ${C_DIM}# Model management${C_RST}\n"
  printf "  keosctl models list                      ${C_DIM}# what's loaded?${C_RST}\n"
  printf "  keosctl models pull qwen2.5:7b           ${C_DIM}# upgrade to a bigger model${C_RST}\n\n"
  printf "  ${C_DIM}# Lifecycle${C_RST}\n"
  printf "  keosctl uninstall --keep-pvcs            ${C_DIM}# clean removal, keep state${C_RST}\n\n"

  printf "${C_BOLD}DOCS${C_RST}\n"
  printf "  https://pocteo-platform.github.io/keos/\n\n"
}

# ─── Main dispatcher ─────────────────────────────────────────────────────────

# Global flags can come before OR after the subcommand. Parse the leading ones.
parse_global() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--namespace)   NAMESPACE="$2"; shift 2 ;;
      -r|--release)     RELEASE="$2"; shift 2 ;;
      --kubeconfig)     KUBECONFIG_OVERRIDE="$2"; shift 2 ;;
      --no-color)       NO_COLOR=1; shift ;;
      -h|--help)        cmd_help; exit 0 ;;
      *)                break ;;
    esac
  done
  REMAINING=("$@")
}

main() {
  parse_global "$@"
  set -- "${REMAINING[@]:-}"
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    install)         cmd_install "$@" ;;
    uninstall)       cmd_uninstall "$@" ;;
    status)          cmd_status "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    mode)            cmd_mode "$@" ;;
    logs)            cmd_logs "$@" ;;
    ui)              cmd_ui "$@" ;;
    token)           cmd_token "$@" ;;
    seed)            cmd_seed "$@" ;;
    models)          cmd_models "$@" ;;
    events|incidents) cmd_events "$@" ;;
    usecases)        cmd_usecases "$@" ;;
    run)             cmd_run "$@" ;;
    restart)         cmd_restart "$@" ;;
    shell|exec)      cmd_shell "$@" ;;
    describe)        cmd_describe "$@" ;;
    port-forward|pf) cmd_portforward "$@" ;;
    upgrade)         cmd_upgrade "$@" ;;
    audit)           cmd_audit "$@" ;;
    completion)      cmd_completion "$@" ;;
    context)         cmd_context "$@" ;;
    version|--version|-v) cmd_version "$@" ;;
    link)            cmd_link "$@" ;;
    help|--help|-h|"") cmd_help ;;
    *)
      printf "${C_RED}${CROSS}${C_RST} unknown command '%s'\n\n" "$cmd"
      printf "Did you mean one of these?\n"
      for c in install uninstall status doctor mode logs ui token seed models events usecases run restart shell describe port-forward upgrade audit completion context version link help; do
        # Cheap fuzzy: print commands that share a prefix or contain the typo.
        if [[ "$c" == "$cmd"* || "$c" == *"$cmd"* ]]; then
          printf "  ${C_CYAN}%s${C_RST}\n" "$c"
        fi
      done
      printf "\nRun ${C_CYAN}keosctl help${C_RST} for the full command list.\n"
      exit 1
      ;;
  esac
}

main "$@"
