#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  keosctl — the Keos SRE Agent CLI
# ─────────────────────────────────────────────────────────────────────────────
#  One tool for the operator's whole lifecycle: install, status, logs, mode
#  flips, port-forward, model management, uninstall. Subcommands wrap the
#  underlying install.sh + install-edge.sh + kubectl + helm + ollama calls
#  with consistent flags + branded output.
#
#  Designed to be symlinked to a directory on PATH (e.g. ~/.local/bin) so
#  the colleague's daily flow is `keosctl <verb>` instead of remembering
#  paths or kubectl incantations.
#
#  Bash 4+ required. No other dependencies beyond what install.sh already
#  needs (kubectl, helm, docker, openssl, python3, curl).
# ─────────────────────────────────────────────────────────────────────────────

set -euo pipefail

KEOSCTL_VERSION="1.1.0"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# ─── Defaults (overridable via env + global flags) ───────────────────────────

NAMESPACE="${KEOS_NAMESPACE:-keos}"
RELEASE="${KEOS_RELEASE:-keos}"
KUBECONFIG_OVERRIDE=""

# ─── Colors ──────────────────────────────────────────────────────────────────

if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
  C_RST=$'\033[0m'
  C_BOLD=$'\033[1m'
  C_DIM=$'\033[2m'
  C_RED=$'\033[31m'
  C_GREEN=$'\033[32m'
  C_YELLOW=$'\033[33m'
  C_BLUE=$'\033[34m'
  C_MAGENTA=$'\033[35m'
  C_CYAN=$'\033[36m'
  C_GREY=$'\033[90m'
else
  C_RST="" C_BOLD="" C_DIM="" C_RED="" C_GREEN="" C_YELLOW="" C_BLUE=""
  C_MAGENTA="" C_CYAN="" C_GREY=""
fi

CHECK="✓"
CROSS="✗"
WARN="⚠"
ARROW="›"

# ─── Helpers ─────────────────────────────────────────────────────────────────

say()   { echo "$@"; }
ok()    { printf "  ${C_GREEN}${CHECK}${C_RST} %s\n" "$*"; }
fail()  { printf "  ${C_RED}${CROSS}${C_RST} %s\n" "$*" >&2; }
warn()  { printf "  ${C_YELLOW}${WARN}${C_RST} %s\n" "$*"; }
info()  { printf "  ${C_BLUE}${ARROW}${C_RST} %s\n" "$*"; }
note()  { printf "  ${C_DIM}%s${C_RST}\n" "$*"; }
die()   { printf "${C_RED}${CROSS}${C_RST} %s\n" "$*" >&2; exit 1; }
hr()    { printf "${C_GREY}────────────────────────────────────────────────────────────────${C_RST}\n"; }
heading(){ printf "\n${C_BOLD}${C_CYAN}%s${C_RST}\n" "$1"; hr; }

# kubectl wrapper that honors the wizard's kubeconfig + namespace.
kc() {
  local args=()
  [[ -n "$KUBECONFIG_OVERRIDE" ]] && args+=("--kubeconfig" "$KUBECONFIG_OVERRIDE")
  kubectl "${args[@]}" -n "$NAMESPACE" "$@"
}

# Same wrapper but cluster-scoped (no -n).
kc_cluster() {
  local args=()
  [[ -n "$KUBECONFIG_OVERRIDE" ]] && args+=("--kubeconfig" "$KUBECONFIG_OVERRIDE")
  kubectl "${args[@]}" "$@"
}

# Pretty-print JSON safely if python3 is available, otherwise fall back to raw.
jq_inline() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c "import sys, json; d=json.load(sys.stdin); $1"
  else
    cat
  fi
}

# Get the first pod of a Keos component (api/mcp-server/frontend/ollama/…).
pod_for() {
  kc get pod -l "app.kubernetes.io/component=$1" \
    -o jsonpath='{.items[0].metadata.name}' 2>/dev/null
}

require_namespace() {
  if ! kc_cluster get namespace "$NAMESPACE" >/dev/null 2>&1; then
    die "namespace '$NAMESPACE' not found — is Keos installed?  Run 'keosctl install' first."
  fi
}

# ─── Per-command help ────────────────────────────────────────────────────────
#
# Each cmd_X function calls `_check_help <name> "$@"` at the very top so the
# user can run `keosctl <cmd> -h` / `--help` and get a focused help screen
# (kubectl / gh / argocd convention). `_help_for <name>` is the dispatch
# table — one case per command with USAGE / DESCRIPTION / OPTIONS / EXAMPLES.

_check_help() {
  local cmd="$1"; shift
  for a in "$@"; do
    case "$a" in
      -h|--help) _help_for "$cmd"; exit 0 ;;
    esac
  done
}

_help_for() {
  case "$1" in
    install) cat <<'EOF'
keosctl install — interactive 6-step wizard (recommended first-time install)

USAGE
  keosctl install [--headless [install-edge.sh flags]]

DESCRIPTION
  Walks an interactive wizard: prerequisites · cluster pick · discovered
  facts · LLM model · image source · default mode · review + install.
  Drives sre-agent/scripts/install-edge.sh under the hood with the chosen
  flags. On success, symlinks keosctl to ~/.local/bin and prints the
  bearer token + daily-ops commands.

OPTIONS
  --headless, --non-interactive  Skip the wizard; pass flags through
                                  directly to install-edge.sh (CI / scripted).

EXAMPLES
  keosctl install
  keosctl install --headless --mode observe-only --no-gpu
  keosctl install --headless --local-build --mode active

SEE ALSO  https://pocteo-platform.github.io/keos/docs/cli/install-uninstall
EOF
      ;;
    gitops) cat <<'EOF'
keosctl gitops — pull-based delivery via Flux (air-gapped, private registry)

USAGE
  keosctl gitops bootstrap --registry <host:5000> --age-key <fleet.agekey> \
                           --config-tag <tag> [--plain-http]
  keosctl gitops render    --registry <host:5000> [--env edge] [--out FILE] [--node NAME]
  keosctl gitops status | sync | suspend | resume

DESCRIPTION
  The cluster runs Flux and PULLS its desired state (the keos-config OCI
  artifact pushed by scripts/release.sh config) from the private :5000
  registry — nothing is pushed in. Secrets are SOPS-encrypted in the
  artifact and decrypted in-cluster with the fleet age key.

  bootstrap  install Flux (images from <reg>/fluxcd), drop the age key
             (sops-age secret), apply the root OCIRepository + Kustomization.
  render     probe this cluster + emit a starter values-<env>.yaml to feed
             to `release.sh config`.
  status     flux sources / kustomizations / helmreleases.
  sync       force an immediate reconcile (else it polls on its interval).
  suspend/resume  pause/resume reconciliation for manual maintenance.

EXAMPLES
  keosctl gitops bootstrap --registry registry.fleet.local:5000 \
      --age-key ./keos-fleet.agekey --config-tag 1.1.0-edge --plain-http
  keosctl gitops render --registry registry.fleet.local:5000 --env edge
  keosctl gitops status

SEE ALSO  docs/GITOPS.md
EOF
      ;;
    release) cat <<'EOF'
keosctl release — populate the private fleet registry (workstation)

USAGE
  REGISTRY=<host:5000> keosctl release {build|mirror|chart|config|verify|all} [--insecure]

DESCRIPTION
  The single entry point for building + publishing everything a fleet device
  pulls: multi-arch first-party images, mirrored third-party images, the OCI
  Helm chart, and (config) the SOPS-encrypted GitOps desired-state artifact.
  Runs on a workstation with docker/buildx, helm, skopeo (+ flux/sops/age/yq
  for `config`). REGISTRY is required (except for `images-list`).

SUBCOMMANDS
  build    multi-arch first-party images (+ Jetson ollama variant)
  mirror   copy pinned third-party images into the registry (multi-arch)
  chart    package + push the Helm chart → oci://<reg>/charts/pocteo
  config   render + SOPS-encrypt + push the GitOps config (see keosctl gitops)
  verify   multi-arch audit of everything in the registry
  all      build + mirror + chart + verify

EXAMPLES
  REGISTRY=registry.fleet.local:5000 keosctl release all --insecure
  ENV=edge KEOS_AGE_RECIPIENT=age1... REGISTRY=registry.fleet.local:5000 keosctl release config

SEE ALSO  docs/INSTALLATION.md (private registry), docs/OPERATIONS.md
EOF
      ;;
    bundle) cat <<'EOF'
keosctl bundle — build an offline air-gap bundle (workstation)

USAGE
  keosctl bundle create [flags]

DESCRIPTION
  Produces a single tarball (first-party + third-party images, the Helm chart,
  install scripts, and pre-pulled Ollama models) to carry to a fully
  disconnected site on a USB stick. On the device: untar, load images into the
  local registry, then `keosctl install` against it.

SEE ALSO  docs/INSTALLATION.md (air-gapped)
EOF
      ;;
    falco-probe) cat <<'EOF'
keosctl falco-probe — build the Falco eBPF probe for this node's kernel

USAGE
  sudo REGISTRY=<host:5000> keosctl falco-probe build [--insecure]

DESCRIPTION
  BTF-less kernels (e.g. NVIDIA Jetson L4T) can't use Falco's CO-RE probe.
  This compiles a legacy-eBPF probe against the running kernel's headers and
  pushes it as a tiny OCI image the chart's initContainer fetches by `uname -r`.
  Run ON the target node (needs the kernel headers + clang/llvm + sudo).
  Re-run after a kernel upgrade.

SEE ALSO  docs/INSTALLATION.md (security sensors), docs/OPERATIONS.md
EOF
      ;;
    uninstall) cat <<'EOF'
keosctl uninstall — remove the Keos release from the cluster

USAGE
  keosctl uninstall [--keep-pvcs] [--keep-namespace] [--yes|-y] [--force|-f]

DESCRIPTION
  Removes the Helm release + PVCs + namespace by default. Confirms before
  any destructive action.

OPTIONS
  --keep-pvcs        Keep the stateful PVCs (audit log, vector store)
  --keep-namespace   Don't delete the namespace
  --yes, -y          Skip the confirm prompt
  --force, -f        Alias for --yes

EXAMPLES
  keosctl uninstall                      # interactive
  keosctl uninstall --keep-pvcs          # remove release, keep state
  keosctl uninstall --force              # CI-friendly
EOF
      ;;
    link) cat <<'EOF'
keosctl link — symlink keosctl into a directory on PATH

USAGE
  keosctl link [path]   (default: ~/.local/bin/keosctl)

DESCRIPTION
  Creates / refreshes the symlink that lets you run keosctl from any cwd.
  The install wizard does this automatically; use this command to re-link
  after deleting the symlink or moving the repo.

EXAMPLES
  keosctl link
  keosctl link /usr/local/bin/keosctl
EOF
      ;;
    upgrade) cat <<'EOF'
keosctl upgrade — Helm upgrade the running release

USAGE
  keosctl upgrade [--chart-version <v>] [--dry-run]

DESCRIPTION
  Helm-upgrades the release with --reuse-values --wait. By default reads
  the chart from the cloned repo (deploy/helm/pocteo). Pass --chart-version
  to pull a specific version from the OCI registry.

OPTIONS
  --chart-version <v>   Pull from oci://ghcr.io/.../charts/pocteo --version v
  --dry-run             Show the helm diff without applying

EXAMPLES
  keosctl upgrade
  keosctl upgrade --chart-version 1.0.2
  keosctl upgrade --chart-version 1.0.2 --dry-run
EOF
      ;;
    status) cat <<'EOF'
keosctl status — release + pods + agent mode summary

USAGE
  keosctl status [--watch|-w] [--interval N] [--json]

DESCRIPTION
  Coloured table with Helm release, namespace, agent mode, and a per-pod
  Ready/phase row. --json emits machine-readable output for monitoring.

OPTIONS
  --watch, -w       Live-refresh every 2s
  --interval N      Override the watch refresh cadence (seconds)
  --json            Machine-readable JSON output

EXAMPLES
  keosctl status
  keosctl status --watch --interval 5
  keosctl status --json | jq '.pods_ready'
EOF
      ;;
    doctor) cat <<'EOF'
keosctl doctor — health check across every component

USAGE
  keosctl doctor

DESCRIPTION
  Probes: Helm release · per-pod phase + readiness · AgentMode CR ·
  Ollama model count · Qdrant runbook corpus count. Exit code = number
  of failures (CI-friendly).
EOF
      ;;
    preflight) cat <<'EOF'
keosctl preflight — pre-install environment checks (run BEFORE installing)

USAGE
  keosctl preflight [--json] [--gpu|--no-gpu] [--local-build]
                    [--image-registry <host:port>] [--insecure]
                    [--model <ollama-model>] [--node <name>]
                    [--containerd-socket <path>] [--no-btf-label]

DESCRIPTION
  Catches environment problems in seconds — with actionable remedies —
  instead of a 10-minute helm timeout. Checks: binaries · cluster +
  distro/containerd socket · node arch vs registry images · memory vs
  model · GPU allocatable (Tegra-aware) · kernel BTF (labels nodes
  keos.pocteo/btf-kernel, consumed by the security ladder) · WSL2 ·
  registry reachability. Exit code = number of failures.

EXAMPLES
  keosctl preflight --gpu --image-registry registry.fleet.local:5000
  keosctl preflight --json | jq '.checks[] | select(.status!="ok")'
EOF
      ;;
    gpu-setup) cat <<'EOF'
keosctl gpu-setup — wire the NVIDIA GPU into k3s containerd (host-side)

USAGE
  keosctl gpu-setup [--apply]      # default: PRINT the commands only
  keosctl gpu-setup status

DESCRIPTION
  Prepares a node so pods can request nvidia.com/gpu:
    1. generate the CDI spec (nvidia-ctk cdi generate --mode=csv)
    2. on Tegra/Jetson: inject the `tegra` alias device into the spec —
       the k8s device plugin allocates under device id `tegra`, which
       neither CSV mode nor the stock CDI spec knows (toolkit/R39 bug)
    3. switch the nvidia runtime to CDI mode
    4. apply the RuntimeClass + NVIDIA device plugin (vendored manifest,
       image mirrored by release.sh — airgap-safe)

  --apply executes (sudo; must run ON the GPU node — the kernel is
  checked). Without it the exact commands are printed for review.
  `status` shows CDI spec / tegra alias / runtime mode / allocatable.

NOTE
  Re-run after a JetPack upgrade: regenerating the CDI spec loses the
  tegra alias. `keosctl doctor` warns when the alias is missing.
EOF
      ;;
    mode) cat <<'EOF'
keosctl mode — print or set the agent's mode

USAGE
  keosctl mode                                   # print current mode
  keosctl mode <observe-only|active|frozen> [--reason TEXT] [--yes|-y]

DESCRIPTION
  observe-only  Dry-run · agent diagnoses but does not mutate (default).
  active        Agent mutates after the OPA policy gate (requires confirm).
  frozen        No-op · use during maintenance windows.

OPTIONS
  --reason TEXT     Audit-friendly free-text reason (saved in the CR)
  --yes, -y         Skip the 'switching to active' confirm

EXAMPLES
  keosctl mode
  keosctl mode active
  keosctl mode active --reason 'on-call coverage' -y
  keosctl mode frozen --reason 'planned maintenance window'
EOF
      ;;
    logs) cat <<'EOF'
keosctl logs — tail a Keos component's pod logs

USAGE
  keosctl logs <component> [kubectl-logs flags]

COMPONENTS
  api · mcp-server · frontend · caddy · ollama · qdrant · nats · opa

KUBECTL FLAGS THAT PASS THROUGH
  -f, --follow              Stream new lines
  --tail N                  Backlog size (default 100)
  --since <duration>        e.g. 1h, 5m
  --since-time <RFC3339>    Time-bounded
  --previous                The previous container instance (post-crash)
  --container <c>           Pick a container in a multi-container pod
  --timestamps              Prefix each line with the timestamp

EXAMPLES
  keosctl logs api -f
  keosctl logs ollama --tail 500 --since 1h
  keosctl logs api --previous --tail 100
EOF
      ;;
    ui) cat <<'EOF'
keosctl ui — port-forward + open the SPA in your browser

USAGE
  keosctl ui [--port N] [--no-open]

DESCRIPTION
  Forwards svc/pocteo to localhost:8080 (or --port N) and tries to open
  the URL in your default browser via xdg-open / open / WSL's
  powershell.exe Start-Process. Prints the bearer token for paste.

OPTIONS
  --port N     Local port (default 8080)
  --no-open    Don't auto-open the browser (useful over SSH)

EXAMPLES
  keosctl ui
  keosctl ui --port 9090
  keosctl ui --no-open    # for SSH-tunneling
EOF
      ;;
    token) cat <<'EOF'
keosctl token — print the bearer token

USAGE
  keosctl token

DESCRIPTION
  Reads from ~/.keos-token if cached, otherwise fetches from the K8s
  Secret + caches at ~/.keos-token (umask 0077). Subsequent calls are
  instant.

EXAMPLES
  keosctl token
  TOKEN=$(keosctl token); curl -H "Authorization: Bearer $TOKEN" ...
EOF
      ;;
    restart) cat <<'EOF'
keosctl restart — rolling restart a component

USAGE
  keosctl restart <component> [--wait]

COMPONENTS
  Deployments (kubectl rollout restart): api · mcp-server · frontend · caddy · opa
  StatefulSets (pod-delete, SS respawns):  ollama · qdrant · nats

OPTIONS
  --wait    Block until the new pod is Ready (max 2 min)

EXAMPLES
  keosctl restart api --wait
  keosctl restart ollama
EOF
      ;;
    shell) cat <<'EOF'
keosctl shell — interactive bash/sh inside a Keos pod

USAGE
  keosctl shell <component>
  keosctl exec  <component>   (alias)

DESCRIPTION
  kubectl exec -it <pod> -- bash (falls back to sh if bash isn't in the
  image). Resolves the right pod name for you.

EXAMPLES
  keosctl shell api
  keosctl shell ollama        # for `ollama ls` etc.
EOF
      ;;
    describe) cat <<'EOF'
keosctl describe — kubectl describe a Keos pod

USAGE
  keosctl describe <component>

DESCRIPTION
  Full kubectl describe of the first pod for that component. Useful for
  init-container state, events, resource allocations.

EXAMPLES
  keosctl describe api
  keosctl describe ollama
EOF
      ;;
    port-forward) cat <<'EOF'
keosctl port-forward — generic kubectl port-forward

USAGE
  keosctl port-forward <component> <local-port>
  keosctl pf <component> <local-port>   (alias)

DESCRIPTION
  Knows the right targetPort for each component:
    api 8000 · mcp-server 8090 · frontend 8080 · ollama 11434 ·
    qdrant 6333 · nats 4222 · opa 8181 · pocteo (caddy) 80

EXAMPLES
  keosctl port-forward api 8000      # talk to /api directly
  keosctl pf ollama 11434            # talk to Ollama from your laptop
EOF
      ;;
    events) cat <<'EOF'
keosctl events — list recent incidents (colored by outcome)

USAGE
  keosctl events [-n N|--limit N] [-w|--watch] [--filter outcome=X] [--since DUR] [--domain D]

COLOURS
  green  healed       yellow  escalated       red  failed       dim  other
  SEC tag marks a security-domain incident; sre tag marks a reliability one.

OPTIONS
  -n, --limit N        Number of incidents (default 10)
  -w, --watch          Refresh every 3s
  --filter outcome=X   (client-side, server filter coming)
  --since DUR          (client-side, server filter coming)
  --domain D           sre | security — show only that agent domain (Phase 21)

EXAMPLES
  keosctl events -n 20
  keosctl events --watch
  keosctl events --filter outcome=escalated
  keosctl events --domain security
EOF
      ;;
    incidents) cat <<'EOF'
keosctl incidents — per-incident inspection + cleanup

USAGE
  keosctl incidents list             (alias for `events`)
  keosctl incidents get    <id>
  keosctl incidents delete <id>      (alias: rm)

EXAMPLES
  keosctl incidents list
  keosctl incidents get inc_2026-06-09_a1b2c3d4
  keosctl incidents delete inc_2026-06-09_a1b2c3d4
EOF
      ;;
    usecases) cat <<'EOF'
keosctl usecases — list or inspect use case definitions

USAGE
  keosctl usecases list [--domain D]
  keosctl usecases show <slug>

OPTIONS
  --domain D   sre | security — show only that domain's scenarios (Phase 21)

EXAMPLES
  keosctl usecases list
  keosctl usecases list --domain security
  keosctl usecases show lib-reverse-shell
EOF
      ;;
    run) cat <<'EOF'
keosctl run — trigger a use case end-to-end

USAGE
  keosctl run <use-case-slug> [--dry-run]

DESCRIPTION
  Calls POST /api/usecases/<slug>/run — same endpoint the SPA's Run
  button uses. The 9-node LangGraph picks it up; watch the live
  animation in the SPA's Pipeline tab.

OPTIONS
  --dry-run    Print the use case definition without firing the event

EXAMPLES
  keosctl usecases list
  keosctl run lib-memory-leak
  keosctl run lib-memory-leak --dry-run
EOF
      ;;
    audit) cat <<'EOF'
keosctl audit — HMAC-signed audit chain

USAGE
  keosctl audit tail [-n N|--lines N]
  keosctl audit verify

DESCRIPTION
  tail     Print the last N records (JSON-lines, default 20)
  verify   Walk the HMAC chain; exit 1 on tamper detection

EXAMPLES
  keosctl audit tail -n 100
  keosctl audit verify
  0 */6 * * * keosctl audit verify >> /var/log/keos-audit.log 2>&1
EOF
      ;;
    seed) cat <<'EOF'
keosctl seed — re-seed the runbook corpus into Qdrant

USAGE
  keosctl seed [--clear-first]

DESCRIPTION
  Calls 'python -m agent.seed_rag' inside the api pod. Re-embeds every
  file in agent/runbooks/*.md and upserts into the 'runbooks' Qdrant
  collection.

OPTIONS
  --clear-first    Drop the runbooks collection before re-seeding
                   (useful after embed model changes or bulk deletions)

EXAMPLES
  keosctl seed
  keosctl seed --clear-first
EOF
      ;;
    models) cat <<'EOF'
keosctl models — manage Ollama LLM weights

USAGE
  keosctl models list
  keosctl models pull [<model>]
  keosctl models rm   <model>
  keosctl models show <model>

DESCRIPTION
  Without a model, `pull` fetches exactly what the agent is configured to
  ask for (the api pod's OLLAMA_CHAT_MODEL + OLLAMA_EMBED_MODEL); the
  default is qwen2.5:3b-instruct-q4_K_M + nomic-embed-text.
  Pulling a model does not switch the agent to it. To change the chat
  model, pull it, then:
    helm upgrade keos <chart> --reuse-values --set ollama.chatModel=<model>

EXAMPLES
  keosctl models list
  keosctl models pull                                 # the agent's models
  keosctl models pull qwen2.5:7b-instruct-q4_K_M      # ~4.5 GB, ≥ 8 GB VRAM
  keosctl models rm qwen2.5:1.5b-instruct-q4_K_M
  keosctl models show qwen2.5:3b-instruct-q4_K_M
EOF
      ;;
    backup) cat <<'EOF'
keosctl backup — full state snapshot tarball

USAGE
  keosctl backup [-o|--output <path>] [--include-models]

CONTENTS
  META · helm-values.yaml · agentmode.yaml · audit.log ·
  qdrant-snapshots/ · manifests.yaml · (--include-models) ollama-models/

OPTIONS
  -o, --output <path>   Explicit output filename (default:
                          keos-backup-<ts>.tar.gz)
  --include-models      Bundle Ollama weights (can be GB)

EXAMPLES
  keosctl backup
  keosctl backup -o /mnt/nfs/keos-2026-06-09.tar.gz
  keosctl backup --include-models -o /mnt/nfs/keos-full.tar.gz
EOF
      ;;
    restore) cat <<'EOF'
keosctl restore — restore from a keosctl backup

USAGE
  keosctl restore <path-to-tarball>

DESCRIPTION
  Restores in order: AgentMode CR · audit.log · qdrant snapshots ·
  (optional) ollama models. Run 'keosctl doctor' afterwards to verify.

  Does NOT touch: helm values (use `helm rollback` first), secrets
  (re-fetch via `keosctl token`), or cluster-scoped resources.

EXAMPLES
  keosctl restore keos-backup-20260608-180000.tar.gz
EOF
      ;;
    diag) cat <<'EOF'
keosctl diag — generate a support bundle

USAGE
  keosctl diag [path]
  keosctl support-bundle [path]   (alias)

CONTENTS
  META · cluster-info dump · ns resources · helm get all ·
  per-component log tail (500 lines) · AgentMode CR · audit tail ·
  doctor output · versions

EXAMPLES
  keosctl diag
  keosctl diag /tmp/issue-1234.tar.gz
EOF
      ;;
    api) cat <<'EOF'
keosctl api — raw API call with bearer auth pre-handled

USAGE
  keosctl api <path> [curl options...]

DESCRIPTION
  kubectl exec's into the api pod and curls http://localhost:8000<path>
  with the cached bearer token. Curl options pass through transparently
  (-X POST, -d, -H, etc.).

EXAMPLES
  keosctl api /api/health
  keosctl api /api/incidents/active
  keosctl api /api/usecases/lib-memory-leak/run -X POST
  keosctl api /api/calibration | jq
EOF
      ;;
    calibration) cat <<'EOF'
keosctl calibration — per-rule confidence thresholds (Phase 12)

USAGE
  keosctl calibration list                              (alias: ls)
  keosctl calibration set <rule_id> <threshold>
  keosctl calibration reset <rule_id>
  keosctl calibration reset --all

DESCRIPTION
  Shows a table of (rule, n, p50_conf, p90_conf, threshold) for every
  rule with ≥ 10 incidents. `set` overrides the auto-learned threshold;
  `reset` returns to auto.

EXAMPLES
  keosctl calibration list
  keosctl calibration set pod.oom_killed 0.85
  keosctl calibration reset pod.oom_killed
  keosctl calibration reset --all
EOF
      ;;
    chaos) cat <<'EOF'
keosctl chaos — Chaos Mesh experiments

USAGE
  keosctl chaos list                               (alias: ls)
  keosctl chaos delete <name> [namespace]          (alias: rm)

DESCRIPTION
  Wraps kubectl on the four Chaos Mesh CRDs (PodChaos / StressChaos /
  NetworkChaos / IOChaos). Lists across all namespaces; delete is
  ns-scoped (default: current --namespace).

EXAMPLES
  keosctl chaos list
  keosctl chaos delete my-experiment workloads
EOF
      ;;
    top) cat <<'EOF'
keosctl top — live one-screen dashboard

USAGE
  keosctl top [--interval N]

DESCRIPTION
  Refreshing display: agent mode + namespace · per-pod table (top 15) ·
  latest 5 incidents. Press Ctrl-C to stop.

OPTIONS
  --interval N    Refresh cadence in seconds (default 2)
EOF
      ;;
    config) cat <<'EOF'
keosctl config — effective configuration summary

USAGE
  keosctl config view                              (alias: show)

DESCRIPTION
  One card with: namespace · release · kubeconfig path · current
  context · agent mode · helm chart · loaded LLM models · env var
  overrides honoured.

  Equivalent to a kubectl-style 'config view' for a Keos install.
EOF
      ;;
    update) cat <<'EOF'
keosctl update — check for a newer keosctl release

USAGE
  keosctl update

DESCRIPTION
  Calls api.github.com/repos/pocteo-platform/keos/releases/latest and
  compares with the local version. On mismatch, prints the one-line
  upgrade command:
    cd $REPO_ROOT && git pull && keosctl link
EOF
      ;;
    context) cat <<'EOF'
keosctl context — show the current kubectl context

USAGE
  keosctl context

DESCRIPTION
  Equivalent to: kubectl config current-context
EOF
      ;;
    version) cat <<'EOF'
keosctl version — print versions

USAGE
  keosctl version

DESCRIPTION
  Prints keosctl version, the running Helm chart, the repo root, and
  the bash version (for bug reports).
EOF
      ;;
    completion) cat <<'EOF'
keosctl completion — generate a shell completion script

USAGE
  keosctl completion <bash|zsh|fish>

EXAMPLES
  eval "$(keosctl completion bash)"
  eval "$(keosctl completion zsh)"
  keosctl completion fish > ~/.config/fish/completions/keosctl.fish

DOCS  https://pocteo-platform.github.io/keos/docs/cli/shell-completion
EOF
      ;;
    deps) cat <<'EOF'
keosctl deps — detect or install ecosystem operators

USAGE
  keosctl deps list                                (alias: verify)
  keosctl deps install <name> [--chart-repo URL] [--version V]
                              [--values FILE] [--namespace NS] [--set k=v]

DESCRIPTION
  Operators Keos uses but doesn't require (Prometheus / ArgoCD / Flux /
  cert-manager / kube-state-metrics / Falco / Tetragon) are detected at
  runtime — the agent adapts. `deps install` adds the missing one via Helm.
  falco and tetragon default to the versions the Keos chart vendors; falco
  delivers through falcosidekick with the agent's webhook token.

SUPPORTED NAMES
  prometheus  argocd  flux  cert-manager  kube-state-metrics  falco  tetragon

EXAMPLES
  keosctl deps list
  keosctl deps install falco
  keosctl deps install prometheus
  keosctl deps install prometheus --chart-repo https://harbor.corp/chartrepo --version 75.0.0
  keosctl deps install argocd --namespace argocd
  keosctl deps install cert-manager --set installCRDs=true
EOF
      ;;
    images) cat <<'EOF'
keosctl images — registry + per-pod image management

USAGE
  keosctl images list
  keosctl images registry
  keosctl images set-registry <host:port>
  keosctl images pull-policy <Always|IfNotPresent|Never>

DESCRIPTION
  list           Per-pod image references currently running
  registry       Current global.imageRegistry + per-component pullPolicy
  set-registry   Swap the registry (helm upgrade --reuse-values)
  pull-policy    Override pullPolicy for api/mcpServer/frontend

EXAMPLES
  keosctl images list
  keosctl images registry
  keosctl images set-registry registry.corp:5000
  keosctl images set-registry ghcr.io/pocteo-platform   # back to public
  keosctl images pull-policy Always                     # force pull on every restart
  keosctl images pull-policy Never                      # local-build mode
EOF
      ;;
    values) cat <<'EOF'
keosctl values — Helm values inspection + editing

USAGE
  keosctl values get [key.path]
  keosctl values set <key>=<value>
  keosctl values edit
  keosctl values diff

DESCRIPTION
  get      Effective values (full or one path via dot notation)
  set      Patch one key via 'helm upgrade --set' (--reuse-values)
  edit     Open the full values yaml in $EDITOR; on save, helm upgrade
  diff    vs the chart's default values

EXAMPLES
  keosctl values get
  keosctl values get ollama.gpu.enabled
  keosctl values set agent.defaultMode=active
  keosctl values set api.replicas=2
  keosctl values edit
  keosctl values diff
EOF
      ;;
    policy) cat <<'EOF'
keosctl policy — OPA Rego matrix introspection

USAGE
  keosctl policy show
  keosctl policy test <action> <severity> <namespace> <mode>

DESCRIPTION
  show   Cat the loaded /policies/agent.rego from the opa pod
  test   Send an OPA input and print the allow/deny decision + reasons

EXAMPLES
  keosctl policy show
  keosctl policy test restart_pod high workloads active
  keosctl policy test drain_node critical kube-system active   # should DENY
  keosctl policy test page_human low workloads observe-only    # always ALLOW
EOF
      ;;
    runbooks) cat <<'EOF'
keosctl runbooks — inspect the runbook corpus

USAGE
  keosctl runbooks list                              (alias: ls)
  keosctl runbooks show <slug>                       (alias: cat)

DESCRIPTION
  list  Every runbook file the api pod has access to + Qdrant point count
  show  Cat one runbook (slug or filename — .md is optional)

EXAMPLES
  keosctl runbooks list
  keosctl runbooks show 001-memory-leak
  keosctl runbooks show security/001-reverse-shell
EOF
      ;;
    quarantine) cat <<'EOF'
keosctl quarantine — list / release security containment (Phase 21)

USAGE
  keosctl quarantine list                          (alias: ls)
  keosctl quarantine release <pod> <namespace>     (alias: undo)

DESCRIPTION
  The security domain's containment tools (isolate_pod / apply_network_policy
  / quarantine_pod) apply a deny-all or deny-egress NetworkPolicy + a
  keos.pocteo/quarantine label. This is the reversible half:
    list     Show every contained pod + the keos-security-agent NetworkPolicies
    release  Delete those NetworkPolicies + strip the labels/annotations,
             returning the pod to normal networking

EXAMPLES
  keosctl quarantine list
  keosctl quarantine release nginx-demo-7b8d5-abc workloads
EOF
      ;;
    bus) cat <<'EOF'
keosctl bus — NATS JetStream subject taps

USAGE
  keosctl bus tail [subject]                         (alias: sub, subscribe)
  keosctl bus streams                                (alias: list)

DESCRIPTION
  tail     Live subscribe to a NATS subject pattern (default infra.events.>)
  streams  List JetStream streams + their config

EXAMPLES
  keosctl bus tail
  keosctl bus tail "infra.events.>"
  keosctl bus tail "infra.events.oom_killed"
  keosctl bus streams
EOF
      ;;
    *)
      cat <<EOF
No detailed help for '$1' yet.
Try 'keosctl help' for the full command list, or open an issue:
  https://github.com/pocteo-platform/keos/issues/new
EOF
      ;;
  esac
}

# Get the API service URL accessible from inside the cluster — used by
# `events`, `run`, `audit` etc. which call FastAPI via kubectl exec.
api_curl() {
  local api_pod token path="$1"
  shift
  api_pod="$(pod_for api)"
  [[ -z "$api_pod" ]] && die "api pod not found"
  if [[ -f "$HOME/.keos-token" ]]; then
    token="$(cat "$HOME/.keos-token")"
  else
    token="$(kc get secret keos-pocteo-auth -o jsonpath='{.data.SHP_API_TOKEN}' 2>/dev/null | base64 -d)"
  fi
  kc exec "$api_pod" -- curl -sf \
    -H "Authorization: Bearer $token" \
    "http://localhost:8000${path}" "$@"
}

# ─── Subcommand: install ─────────────────────────────────────────────────────

cmd_install() {
  _check_help install "$@"
  local interactive=1
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --headless|--non-interactive) interactive=0; shift ;;
      *) break ;;
    esac
  done
  if [[ $interactive -eq 1 ]]; then
    [[ -r "$SCRIPT_DIR/install.sh" ]] || die "install.sh not found at $SCRIPT_DIR"
    exec bash "$SCRIPT_DIR/install.sh" "$@"
  else
    [[ -r "$SCRIPT_DIR/install-edge.sh" ]] || die "install-edge.sh not found at $SCRIPT_DIR"
    exec bash "$SCRIPT_DIR/install-edge.sh" "$@"
  fi
}

# ─── Subcommand: uninstall ───────────────────────────────────────────────────

cmd_uninstall() {
  _check_help uninstall "$@"
  local keep_pvcs=0 keep_ns=0 yes=0 force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --keep-pvcs)      keep_pvcs=1; shift ;;
      --keep-namespace) keep_ns=1; shift ;;
      --yes|-y)         yes=1; shift ;;
      --force|-f)       force=1; yes=1; shift ;;
      *) die "unrecognized argument '$1' — run this command with -h/--help to see valid options." ;;
    esac
  done

  if ! kc_cluster get namespace "$NAMESPACE" >/dev/null 2>&1; then
    warn "namespace $NAMESPACE doesn't exist — nothing to uninstall"
    return 0
  fi

  if [[ $yes -eq 0 ]]; then
    heading "Uninstall Keos"
    info "Release       $RELEASE"
    info "Namespace     $NAMESPACE"
    info "Keep PVCs?    $([[ $keep_pvcs -eq 1 ]] && echo yes || echo no)"
    info "Keep ns?      $([[ $keep_ns -eq 1 ]] && echo yes || echo no)"
    printf "\n  Continue? [y/N] "
    read -r answer || answer=""
    [[ "$answer" =~ ^[Yy] ]] || { say "Aborted."; return 0; }
  fi

  say "Removing Helm release '$RELEASE'…"
  helm uninstall "$RELEASE" -n "$NAMESPACE" 2>&1 | tail -3 || true
  if [[ $keep_pvcs -eq 0 ]]; then
    say "Removing PVCs…"
    kc delete pvc --all --ignore-not-found 2>&1 | tail -3 || true
  fi
  if [[ $keep_ns -eq 0 ]]; then
    say "Deleting namespace '$NAMESPACE'…"
    kc_cluster delete namespace "$NAMESPACE" --ignore-not-found --wait=false 2>&1 | tail -3 || true
  fi
  ok "Uninstall complete"
}

# ─── Subcommand: status ──────────────────────────────────────────────────────

cmd_status() {
  _check_help status "$@"
  local watch=0 as_json=0 interval=2
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -w|--watch) watch=1; shift ;;
      --interval) interval="$2"; shift 2 ;;
      --json) as_json=1; shift ;;
      *) die "unrecognized argument '$1' — run this command with -h/--help to see valid options." ;;
    esac
  done
  if [[ $as_json -eq 1 ]]; then
    require_namespace
    local mode
    mode=$(kc_cluster get agentmode default -o jsonpath='{.spec.mode}' 2>/dev/null || echo '?')
    kc get pods -o json 2>/dev/null | python3 -c "
import json, sys
pods = json.load(sys.stdin)['items']
out = {
  'namespace': '${NAMESPACE}',
  'release': '${RELEASE}',
  'mode': '${mode}',
  'pods': [{
    'name': p['metadata']['name'],
    'phase': p['status'].get('phase'),
    'ready': all(c.get('ready', False) for c in p['status'].get('containerStatuses', []) or [{}]),
  } for p in pods],
  'pods_ready': sum(1 for p in pods if all(c.get('ready', False) for c in p['status'].get('containerStatuses', []) or [{}])),
  'pods_total': len(pods),
}
print(json.dumps(out, indent=2))
"
    return 0
  fi
  if [[ $watch -eq 1 ]]; then
    while true; do
      clear
      _print_status
      printf "\n${C_DIM}Refreshing every %ss — Ctrl-C to stop${C_RST}\n" "$interval"
      sleep "$interval"
    done
  else
    _print_status
  fi
}

_print_status() {
  require_namespace
  heading "Keos status"

  # Helm release.
  local chart status_word
  if chart=$(helm list -n "$NAMESPACE" -f "^${RELEASE}\$" -o json 2>/dev/null | \
             jq_inline 'print(d[0]["chart"]) if d else exit(1)' 2>/dev/null); then
    status_word=$(helm list -n "$NAMESPACE" -f "^${RELEASE}\$" -o json 2>/dev/null | \
                   jq_inline 'print(d[0]["status"]) if d else print("?")')
    info "Release       ${C_BOLD}$chart${C_RST}  ${C_DIM}($status_word)${C_RST}"
  else
    fail "Helm release '$RELEASE' not found"
    return 1
  fi
  info "Namespace     $NAMESPACE"

  # Agent mode CR.
  local mode
  mode=$(kc_cluster get agentmode default -o jsonpath='{.spec.mode}' 2>/dev/null || echo '?')
  local mode_color="$C_GREEN"
  [[ "$mode" == "active" ]] && mode_color="$C_YELLOW"
  [[ "$mode" == "frozen" ]] && mode_color="$C_BLUE"
  printf "  ${C_BLUE}${ARROW}${C_RST} Agent mode    ${mode_color}${C_BOLD}%s${C_RST}\n" "$mode"

  # Pod summary.
  printf "\n${C_BOLD}Pods${C_RST}\n"
  local total=0 ready=0
  while IFS= read -r line; do
    local name="$(echo "$line" | awk '{print $1}')"
    local ready_col="$(echo "$line" | awk '{print $2}')"
    local phase="$(echo "$line" | awk '{print $3}')"
    local age="$(echo "$line" | awk '{print $5}')"
    total=$((total + 1))
    local color="$C_RED" mark="$CROSS"
    if [[ "$phase" == "Running" && "$ready_col" =~ ^[1-9].*/[1-9] ]]; then
      color="$C_GREEN" mark="$CHECK"
      ready=$((ready + 1))
    elif [[ "$phase" == "Running" ]]; then
      color="$C_YELLOW" mark="$WARN"
    fi
    printf "  ${color}%s${C_RST} %-42s ${C_DIM}%-10s %s${C_RST}\n" "$mark" "$name" "$ready_col" "$age"
  done < <(kc get pods --no-headers 2>/dev/null)
  printf "  ${C_DIM}%d/%d pods Ready${C_RST}\n" "$ready" "$total"

  # Hints.
  printf "\n${C_BOLD}Access${C_RST}\n"
  note "Open the SPA:        keosctl ui"
  note "Get the token:       keosctl token"
  note "Tail the agent:      keosctl logs api -f"
  printf "\n"
}

# ─── Subcommand: preflight ───────────────────────────────────────────────────

cmd_preflight() {
  _check_help preflight "$@"
  [[ -r "$SCRIPT_DIR/preflight.sh" ]] || die "preflight.sh not found at $SCRIPT_DIR (re-clone the repo or re-link keosctl)"
  exec bash "$SCRIPT_DIR/preflight.sh" "$@"
}

# ─── Subcommand: gpu-setup ───────────────────────────────────────────────────

_gpu_tegra_alias_py() {
  # Injects a `tegra` alias device (copy of `all`) into /etc/cdi/nvidia.yaml.
  # The k8s device plugin allocates the Tegra iGPU under device id `tegra`,
  # which the stock CDI spec doesn't define (nvidia-container-toolkit ≤1.19
  # on L4T R39). Idempotent.
  cat <<'PYEOF'
import yaml
p = "/etc/cdi/nvidia.yaml"
spec = yaml.safe_load(open(p))
names = [d["name"] for d in spec["devices"]]
if "tegra" not in names:
    alias = dict(next(d for d in spec["devices"] if d["name"] == "all"))
    alias["name"] = "tegra"
    spec["devices"].append(alias)
    yaml.safe_dump(spec, open(p, "w"), default_flow_style=False)
print("devices:", [d["name"] for d in yaml.safe_load(open(p))["devices"]])
PYEOF
}

cmd_gpu_setup() {
  _check_help gpu-setup "$@"
  local mode="print" plugin_manifest="$REPO_ROOT/manifests/nvidia-device-plugin.yaml"
  case "${1:-}" in
    --apply) mode="apply" ;;
    status)  mode="status" ;;
    "")      ;;
    *) die "usage: keosctl gpu-setup [--apply] | keosctl gpu-setup status" ;;
  esac

  local is_tegra=0
  [[ -f /etc/nv_tegra_release ]] && is_tegra=1

  if [[ "$mode" == "status" ]]; then
    heading "GPU setup status (host: $(hostname))"
    if [[ -f /etc/cdi/nvidia.yaml ]]; then
      ok "CDI spec present: /etc/cdi/nvidia.yaml"
      if grep -qE '^\s*-?\s*name:\s*tegra\b' /etc/cdi/nvidia.yaml; then
        ok "tegra alias device present"
      elif [[ "$is_tegra" -eq 1 ]]; then
        warn "tegra alias MISSING — pods will fail with 'unsupported device id: tegra'; run: keosctl gpu-setup --apply"
      fi
    else
      warn "no CDI spec at /etc/cdi/nvidia.yaml"
    fi
    if [[ -r /etc/nvidia-container-runtime/config.toml ]]; then
      note "runtime mode: $(grep -E '^mode = ' /etc/nvidia-container-runtime/config.toml || echo 'mode = (default auto)')"
    fi
    note "allocatable: nvidia.com/gpu=$(kc get nodes -o jsonpath='{.items[0].status.allocatable.nvidia\.com/gpu}' 2>/dev/null || echo '?')"
    return 0
  fi

  # The CDI spec must match THIS host's driver — refuse to apply remotely.
  if [[ "$mode" == "apply" ]]; then
    command -v nvidia-ctk >/dev/null || die "nvidia-ctk not found — install nvidia-container-toolkit first"
    python3 -c "import yaml" 2>/dev/null || die "python3-yaml needed for the tegra alias (apt install python3-yaml)"
  fi

  local cmds=(
    "sudo nvidia-ctk cdi generate --mode=csv --output=/etc/cdi/nvidia.yaml"
  )
  [[ "$is_tegra" -eq 1 || "$mode" == "print" ]] && cmds+=(
    "sudo python3 - <<'PY'  # tegra alias (Jetson only — see 'keosctl help gpu-setup')
$(_gpu_tegra_alias_py)
PY"
  )
  cmds+=(
    "sudo nvidia-ctk config --in-place --set nvidia-container-runtime.mode=cdi"
    "kubectl apply -f ${plugin_manifest:-<repo>/manifests/nvidia-device-plugin.yaml}"
  )

  if [[ "$mode" == "print" ]]; then
    heading "GPU setup — commands to run on the GPU node (or: keosctl gpu-setup --apply)"
    printf '%s\n\n' "${cmds[@]}"
    note "verify afterwards: kubectl get nodes -o jsonpath='{.items[0].status.allocatable.nvidia\\.com/gpu}' → 1"
    return 0
  fi

  heading "GPU setup — applying on $(hostname)"
  sudo nvidia-ctk cdi generate --mode=csv --output=/etc/cdi/nvidia.yaml \
    || die "CDI spec generation failed"
  ok "CDI spec generated"
  if [[ "$is_tegra" -eq 1 ]]; then
    _gpu_tegra_alias_py | sudo python3 - || die "tegra alias injection failed"
    ok "tegra alias device ensured"
  fi
  sudo nvidia-ctk config --in-place --set nvidia-container-runtime.mode=cdi \
    || die "could not set runtime mode=cdi"
  ok "nvidia runtime mode=cdi"
  [[ -f "$plugin_manifest" ]] || die "device-plugin manifest not found at $plugin_manifest"
  kc apply -f "$plugin_manifest" >/dev/null || die "device plugin apply failed"
  ok "RuntimeClass + NVIDIA device plugin applied"
  note "waiting for the kubelet to advertise the GPU…"
  local i
  for i in $(seq 1 24); do
    local alloc
    alloc=$(kc get nodes -o jsonpath='{.items[0].status.allocatable.nvidia\.com/gpu}' 2>/dev/null || true)
    if [[ -n "$alloc" && "$alloc" != "0" ]]; then ok "nvidia.com/gpu allocatable: $alloc"; return 0; fi
    sleep 5
  done
  warn "GPU still not allocatable after 2m — check: kubectl -n kube-system logs ds/nvidia-device-plugin-daemonset"
  return 1
}

# ─── Subcommand: doctor ──────────────────────────────────────────────────────

cmd_doctor() {
  _check_help doctor "$@"
  local e2e=0
  for a in "$@"; do [[ "$a" == "--e2e" ]] && e2e=1; done
  require_namespace
  heading "Keos doctor"
  local fails=0

  if helm list -n "$NAMESPACE" -f "^${RELEASE}\$" -q 2>/dev/null | grep -q .; then
    ok "Helm release deployed"
  else
    fail "Helm release '$RELEASE' not found"
    fails=$((fails + 1))
  fi

  for component in api mcp-server frontend ollama qdrant nats opa caddy; do
    local phase
    phase=$(kc get pod -l "app.kubernetes.io/component=$component" \
              -o jsonpath='{.items[0].status.phase}' 2>/dev/null || echo '')
    if [[ "$phase" == "Running" ]]; then
      local ready
      ready=$(kc get pod -l "app.kubernetes.io/component=$component" \
                -o jsonpath='{.items[0].status.containerStatuses[0].ready}' 2>/dev/null)
      if [[ "$ready" == "true" ]]; then
        ok "$(printf '%-15s' "$component")  Running (ready)"
      else
        warn "$(printf '%-15s' "$component")  Running but not Ready"
        fails=$((fails + 1))
      fi
    elif [[ -z "$phase" ]]; then
      fail "$(printf '%-15s' "$component")  pod missing"
      fails=$((fails + 1))
    else
      fail "$(printf '%-15s' "$component")  $phase"
      fails=$((fails + 1))
    fi
  done

  local mode
  mode=$(kc_cluster get agentmode default -o jsonpath='{.spec.mode}' 2>/dev/null || echo '')
  if [[ -n "$mode" ]]; then
    ok "AgentMode CR present (mode=$mode)"
  else
    fail "AgentMode CR missing — agent won't know what to do"
    fails=$((fails + 1))
  fi

  # Ollama models — are the chat + embed models loaded?
  local ollama_pod
  ollama_pod="$(pod_for ollama)"
  if [[ -n "$ollama_pod" ]]; then
    local model_count
    model_count=$(kc exec "$ollama_pod" -- ollama list 2>/dev/null | tail -n +2 | wc -l)
    if (( model_count >= 2 )); then
      ok "$(printf '%-15s' 'ollama models')  $model_count present"
    elif (( model_count >= 1 )); then
      warn "$(printf '%-15s' 'ollama models')  only $model_count loaded (need chat + embed)"
      fails=$((fails + 1))
    else
      fail "$(printf '%-15s' 'ollama models')  none loaded — run 'keosctl models pull qwen2.5:3b-instruct-q4_K_M'"
      fails=$((fails + 1))
    fi
  fi

  # Qdrant runbook count.
  local api_pod
  api_pod="$(pod_for api)"
  if [[ -n "$api_pod" ]]; then
    local pts
    pts=$(kc exec "$api_pod" -- curl -sf http://qdrant:6333/collections/runbooks 2>/dev/null | \
           jq_inline 'print(d["result"]["points_count"])' 2>/dev/null || echo '?')
    if [[ "$pts" =~ ^[1-9] ]]; then
      ok "$(printf '%-15s' 'runbook corpus')  $pts points in Qdrant"
    else
      warn "$(printf '%-15s' 'runbook corpus')  no points found — run 'keosctl seed'"
      fails=$((fails + 1))
    fi
  fi

  # ── Portability / placement checks (added for fleet installs) ──────────
  # Arch sanity: the in-pod kubectl must run — an amd64 binary in an arm64
  # image is the bug that crashed the agent graph on the Jetson.
  if [[ -n "$api_pod" ]]; then
    if kc exec "$api_pod" -- kubectl version --client >/dev/null 2>&1; then
      ok "$(printf '%-15s' 'in-pod kubectl')  runs (arch OK)"
    else
      fail "$(printf '%-15s' 'in-pod kubectl')  fails to exec — image/arch mismatch"
      fails=$((fails + 1))
    fi
  fi

  # GPU placement: when a GPU install, the chat model must be on the GPU.
  if [[ -n "$ollama_pod" ]]; then
    local proc
    proc=$(kc exec "$ollama_pod" -- ollama ps 2>/dev/null | awk 'NR==2{print $5,$6}')
    if [[ -n "$proc" ]]; then
      # A CPU/GPU split still means the GPU runner loaded (expected under
      # memory pressure). Only a GPU-less placement is the silent-fallback bug.
      if [[ "$proc" == *GPU* ]]; then
        ok "$(printf '%-15s' 'ollama gpu')  model using GPU ($proc)"
      else
        warn "$(printf '%-15s' 'ollama gpu')  model on $proc (no GPU) — check runtimeClass / keosctl gpu-setup"
      fi
    fi
  fi

  # Security tier consistency: the recorded tier vs the BTF labels.
  local tier
  tier=$(helm get values "$RELEASE" -n "$NAMESPACE" -o json 2>/dev/null \
          | jq_inline 'print((d.get("keosSecurity") or {}).get("tier",""))' 2>/dev/null || echo '')
  if [[ -n "$tier" ]]; then
    local btf_true
    btf_true=$(kc_cluster get nodes -l keos.pocteo/btf-kernel=true -o name 2>/dev/null | wc -l)
    case "$tier" in
      modern_ebpf) [[ "$btf_true" -gt 0 ]] && ok "$(printf '%-15s' 'security tier')  modern_ebpf (BTF nodes present)" \
                     || warn "$(printf '%-15s' 'security tier')  modern_ebpf but no btf-kernel=true node — falco may crashloop" ;;
      ebpf-prebuilt) ok "$(printf '%-15s' 'security tier')  ebpf-prebuilt (Falco 0.40 legacy probe; tetragon off)" ;;
      off) note "$(printf '%-15s' 'security tier')  off (synthetic events only)" ;;
      *) note "$(printf '%-15s' 'security tier')  $tier" ;;
    esac
  fi

  # On-device extras (only meaningful when doctor runs on the node).
  if [[ -e /sys/kernel/btf/vmlinux || -f /etc/nv_tegra_release ]]; then :; fi
  if [[ -f /etc/nv_tegra_release && -f /etc/cdi/nvidia.yaml ]]; then
    if grep -qE '^\s*-?\s*name:\s*tegra\b' /etc/cdi/nvidia.yaml; then
      ok "$(printf '%-15s' 'cdi tegra alias')  present"
    else
      warn "$(printf '%-15s' 'cdi tegra alias')  MISSING (JetPack upgrade?) — run 'keosctl gpu-setup --apply'"
    fi
  fi
  # Swap on small nodes (the Jetson OOM lesson) — only checkable locally.
  if [[ -r /proc/meminfo ]]; then
    local mem_gib swap_kb
    mem_gib=$(awk '/MemTotal/{print int($2/1024/1024)}' /proc/meminfo)
    swap_kb=$(awk '/SwapTotal/{print $2}' /proc/meminfo)
    if [[ "$mem_gib" -lt 16 && "${swap_kb:-0}" -eq 0 ]]; then
      warn "$(printf '%-15s' 'swap')  none on a ${mem_gib}GiB node — model load may OOM; add a swapfile"
    fi
  fi

  # ── Optional live security e2e ─────────────────────────────────────────
  if [[ "$e2e" -eq 1 ]]; then
    heading "doctor --e2e: live security detection"
    local target
    target=$(kc_cluster -n workloads get pod -l app=nginx-demo -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || echo '')
    if [[ -z "$target" ]]; then
      warn "no nginx-demo pod in 'workloads' — skipping e2e (install seeds it by default)"
    else
      local before
      before=$(api_curl "/api/incidents?domain=security&limit=50" 2>/dev/null | jq_inline 'print(len(d or []))' 2>/dev/null || echo 0)
      note "triggering 'Read sensitive file untrusted' in workloads/$target…"
      kc_cluster -n workloads exec "$target" -- cat /etc/shadow >/dev/null 2>&1 || true
      local i found=0
      for i in $(seq 1 12); do
        sleep 5
        local now
        now=$(api_curl "/api/incidents?domain=security&limit=50" 2>/dev/null | jq_inline 'print(len(d or []))' 2>/dev/null || echo 0)
        if [[ "${now:-0}" -gt "${before:-0}" ]]; then found=1; break; fi
      done
      if [[ "$found" -eq 1 ]]; then
        ok "e2e: a new security incident appeared — Falco→agent delivery works"
      else
        fail "e2e: no incident within 60s — check falco/falcosidekick logs + FALCO_WEBHOOK_TOKEN"
        fails=$((fails + 1))
      fi
    fi
  fi

  printf "\n"
  if [[ $fails -eq 0 ]]; then
    printf "  ${C_GREEN}${C_BOLD}All checks passed.${C_RST}\n"
    return 0
  else
    printf "  ${C_YELLOW}${C_BOLD}%d check(s) failed.${C_RST}  Use 'keosctl logs <component>' for details.\n" "$fails"
    return 1
  fi
}

# ─── Subcommand: mode ────────────────────────────────────────────────────────

cmd_mode() {
  _check_help mode "$@"
  local new_mode="" reason="" yes=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --reason)  reason="$2"; shift 2 ;;
      --yes|-y)  yes=1; shift ;;
      *) [[ -z "$new_mode" ]] && new_mode="$1" && shift || { shift; } ;;
    esac
  done
  if [[ -z "$new_mode" ]]; then
    local mode
    mode=$(kc_cluster get agentmode default -o jsonpath='{.spec.mode}' 2>/dev/null || echo '')
    [[ -z "$mode" ]] && die "AgentMode CR not found"
    say "$mode"
    return 0
  fi
  case "$new_mode" in
    observe-only|active|frozen) ;;
    *) die "invalid mode '$new_mode' — valid: observe-only / active / frozen" ;;
  esac
  if [[ "$new_mode" == "active" && $yes -eq 0 ]]; then
    printf "  ${C_YELLOW}${WARN}${C_RST} Switching to ${C_BOLD}active${C_RST} — agent will mutate the cluster.\n"
    printf "  Continue? [y/N] "
    read -r answer || answer=""
    [[ "$answer" =~ ^[Yy] ]] || { say "Aborted."; return 0; }
  fi
  local patch="{\"spec\":{\"mode\":\"$new_mode\"}"
  [[ -n "$reason" ]] && patch="${patch%\}},\"reason\":\"$reason\"}"
  patch="${patch}}"
  kc_cluster patch agentmode default --type=merge -p "$patch" >/dev/null
  ok "Agent mode set to ${C_BOLD}$new_mode${C_RST}${reason:+ (reason: $reason)}"
}

# ─── Subcommand: logs ────────────────────────────────────────────────────────

cmd_logs() {
  _check_help logs "$@"
  require_namespace
  local component="${1:-}"
  shift || true
  if [[ -z "$component" || "$component" == "-h" || "$component" == "--help" ]]; then
    say "Usage: keosctl logs <component> [-f|--follow] [--tail N]"
    say ""
    say "Components:"
    say "  api          The Keos FastAPI + LangGraph agent"
    say "  mcp-server   The MCP action tool server"
    say "  frontend     The React SPA (nginx)"
    say "  caddy        The HTTP/WS reverse proxy"
    say "  ollama       The local LLM runtime"
    say "  qdrant       The RAG vector store"
    say "  nats         The event bus"
    say "  opa          The policy engine"
    return 0
  fi
  case "$component" in
    api|mcp-server|frontend|ollama|qdrant|nats|opa|caddy) ;;
    *) die "unknown component '$component' — try 'keosctl logs' to list components" ;;
  esac
  # All kubectl logs flags pass through transparently — --since, --since-time,
  # --previous, --container, --tail, --timestamps, -f.
  kc logs -l "app.kubernetes.io/component=$component" --tail=100 "$@"
}

# ─── Subcommand: ui ──────────────────────────────────────────────────────────

cmd_ui() {
  _check_help ui "$@"
  require_namespace
  local port=8080
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --port) port="$2"; shift 2 ;;
      --no-open) NO_OPEN=1; shift ;;
      *) die "unrecognized argument '$1' — run this command with -h/--help to see valid options." ;;
    esac
  done

  local token=""
  [[ -f "$HOME/.keos-token" ]] && token="$(cat "$HOME/.keos-token")"
  if [[ -z "$token" ]]; then
    token="$(kc get secret keos-pocteo-auth -o jsonpath='{.data.SHP_API_TOKEN}' 2>/dev/null | base64 -d 2>/dev/null)" || true
  fi

  heading "Opening Keos SPA"
  info "URL           ${C_CYAN}http://localhost:$port${C_RST}"
  if [[ -n "$token" ]]; then
    info "Token         ${C_GREEN}${C_BOLD}$token${C_RST}"
    note "(paste this into the login screen; also cached at ~/.keos-token)"
  else
    note "Token not found yet — run 'keosctl token' once pods are Ready"
  fi
  printf "\n"
  note "Port-forwarding svc/pocteo on :$port — press Ctrl-C to stop."
  printf "\n"

  # Try to open the browser after a short delay (so the forward is up).
  if [[ "${NO_OPEN:-}" != "1" ]]; then
    if command -v xdg-open >/dev/null; then
      (sleep 2 && xdg-open "http://localhost:$port" >/dev/null 2>&1) &
    elif command -v open >/dev/null; then
      (sleep 2 && open "http://localhost:$port" >/dev/null 2>&1) &
    elif command -v powershell.exe >/dev/null; then
      # WSL → Windows browser
      (sleep 2 && powershell.exe Start-Process "http://localhost:$port" >/dev/null 2>&1) &
    fi
  fi

  # kc is a shell function — exec can't run it (exec needs a real binary).
  kc port-forward svc/pocteo "$port:80" --address=0.0.0.0
}

# ─── Subcommand: token ───────────────────────────────────────────────────────

cmd_token() {
  _check_help token "$@"
  if [[ -f "$HOME/.keos-token" ]]; then
    cat "$HOME/.keos-token"; echo
    return 0
  fi
  require_namespace
  local t
  t="$(kc get secret keos-pocteo-auth -o jsonpath='{.data.SHP_API_TOKEN}' 2>/dev/null | base64 -d 2>/dev/null)"
  if [[ -n "$t" ]]; then
    echo "$t"
    # Cache it for next time.
    umask 0077
    echo "$t" > "$HOME/.keos-token"
  else
    die "token not found — is the API pod Ready?"
  fi
}

# ─── Subcommand: seed ────────────────────────────────────────────────────────

cmd_seed() {
  _check_help seed "$@"
  require_namespace
  local clear_first=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --clear-first|--clear) clear_first=1; shift ;;
      *) die "unrecognized argument '$1' — run this command with -h/--help to see valid options." ;;
    esac
  done
  local api_pod
  api_pod="$(pod_for api)"
  [[ -z "$api_pod" ]] && die "api pod not found"
  if [[ $clear_first -eq 1 ]]; then
    info "Dropping the existing 'runbooks' collection first…"
    kc exec "$api_pod" -- curl -sf -X DELETE http://qdrant:6333/collections/runbooks 2>/dev/null && ok "Collection dropped"
  fi
  say "Seeding runbooks into Qdrant…"
  kc exec "$api_pod" -- python -m agent.seed_rag
  ok "Done"
}

# ─── Subcommand: models ──────────────────────────────────────────────────────

cmd_models() {
  _check_help models "$@"
  require_namespace
  local action="${1:-list}"
  shift || true
  local ollama_pod
  ollama_pod="$(pod_for ollama)"
  [[ -z "$ollama_pod" ]] && die "ollama pod not found"
  case "$action" in
    list)
      kc exec "$ollama_pod" -- ollama list
      ;;
    pull)
      local -a pull_models=("$@")
      if [[ ${#pull_models[@]} -eq 0 ]]; then
        # No argument: the models the agent actually asks Ollama for.
        local api_pod chat embed
        api_pod="$(pod_for api)"
        if [[ -n "$api_pod" ]]; then
          chat="$(kc get pod "$api_pod" -o jsonpath='{.spec.containers[0].env[?(@.name=="OLLAMA_CHAT_MODEL")].value}' 2>/dev/null)"
          embed="$(kc get pod "$api_pod" -o jsonpath='{.spec.containers[0].env[?(@.name=="OLLAMA_EMBED_MODEL")].value}' 2>/dev/null)"
        fi
        pull_models=("${chat:-qwen2.5:3b-instruct-q4_K_M}" "${embed:-nomic-embed-text}")
      fi
      local model
      for model in "${pull_models[@]}"; do
        say "Pulling $model… (this can take several minutes)"
        kc exec "$ollama_pod" -- ollama pull "$model"
        ok "Pulled $model"
      done
      ;;
    rm)
      local model="${1:-}"
      [[ -z "$model" ]] && die "usage: keosctl models rm <model>"
      kc exec "$ollama_pod" -- ollama rm "$model"
      ok "Removed $model"
      ;;
    show)
      local model="${1:-}"
      [[ -z "$model" ]] && die "usage: keosctl models show <model>"
      kc exec "$ollama_pod" -- ollama show "$model"
      ;;
    *) die "unknown action '$action' — valid: list / pull / rm / show" ;;
  esac
}

