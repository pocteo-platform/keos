  printf "  keosctl status                           ${C_DIM}# how's everything?${C_RST}\n"
  printf "  keosctl mode active                      ${C_DIM}# let the agent take action${C_RST}\n"
  printf "  keosctl logs api -f                      ${C_DIM}# tail the API pod${C_RST}\n"
  printf "  keosctl ui                               ${C_DIM}# opens http://localhost:8080${C_RST}\n"
  printf "  keosctl token                            ${C_DIM}# print the bearer token${C_RST}\n\n"
  printf "  ${C_DIM}# Model management${C_RST}\n"
  printf "  keosctl models list                      ${C_DIM}# what's loaded?${C_RST}\n"
  printf "  keosctl models pull                      ${C_DIM}# the agent's models (default qwen2.5:3b)${C_RST}\n\n"
  printf "  ${C_DIM}# Lifecycle${C_RST}\n"
  printf "  keosctl uninstall --keep-pvcs            ${C_DIM}# clean removal, keep state${C_RST}\n\n"

  printf "${C_BOLD}DOCS${C_RST}\n"
  printf "  https://pocteo-platform.github.io/keos/\n\n"
}

# ─── Main dispatcher ─────────────────────────────────────────────────────────

# Global flags can come before OR after the subcommand. Parse the leading ones.
parse_global() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -n|--namespace)   NAMESPACE="$2"; shift 2 ;;
      -r|--release)     RELEASE="$2"; shift 2 ;;
      --kubeconfig)     KUBECONFIG_OVERRIDE="$2"; shift 2 ;;
      --no-color)       NO_COLOR=1; shift ;;
      -h|--help)        cmd_help; exit 0 ;;
      *)                break ;;
    esac
  done
  REMAINING=("$@")
}

# ─── Subcommand: gitops (Phase 23 — Flux pull-based delivery) ────────────────
# Operator surface for the air-gapped, private-registry GitOps model. The
# desired state is an OCI artifact in :5000 (pushed by scripts/release.sh
# config); Flux on the cluster pulls + reconciles it. No inbound push.
cmd_gitops() {
  _check_help gitops "$@"
  local action="${1:-status}"; shift || true
  case "$action" in
    bootstrap)        _gitops_bootstrap "$@" ;;
    render)           _gitops_render "$@" ;;
    status|st)        _gitops_status "$@" ;;
    sync|reconcile)   _gitops_sync "$@" ;;
    suspend)          command -v flux >/dev/null || die "flux CLI not found"
                      flux suspend kustomization keos -n flux-system && ok "GitOps reconciliation suspended" ;;
    resume)           command -v flux >/dev/null || die "flux CLI not found"
                      flux resume kustomization keos -n flux-system && ok "GitOps reconciliation resumed" ;;
    *) die "usage: keosctl gitops {bootstrap|render|status|sync|suspend|resume}" ;;
  esac
}

_gitops_status() {
  command -v flux >/dev/null || die "flux CLI not found (install it on the workstation)"
  heading "Flux GitOps status"
  flux get sources oci -A 2>&1 || true
  printf "\n"
  flux get kustomizations -A 2>&1 || true
  printf "\n"
  flux get helmreleases -A 2>&1 || true
}

_gitops_sync() {
  command -v flux >/dev/null || die "flux CLI not found"
  info "Forcing reconcile of the keos-config source + release…"
  flux reconcile source oci keos-config -n flux-system 2>&1 || warn "source reconcile failed (bootstrapped?)"
  flux reconcile kustomization keos -n flux-system --with-source 2>&1 || true
  flux reconcile helmrelease keos -n flux-system 2>&1 || true
  ok "reconcile triggered — watch with: keosctl gitops status"
}

_gitops_bootstrap() {
  command -v flux >/dev/null || die "flux CLI required — https://fluxcd.io/flux/installation/"
  command -v envsubst >/dev/null || die "envsubst required (gettext)"
  local reg="" plain=0 agekey="" ctag="" comp="source-controller,helm-controller,kustomize-controller"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --registry)    reg="$2"; shift 2 ;;
      --plain-http)  plain=1; shift ;;
      --age-key)     agekey="$2"; shift 2 ;;
      --config-tag)  ctag="$2"; shift 2 ;;
      *) die "unknown arg: $1 (see 'keosctl gitops --help')" ;;
    esac
  done
  [[ -n "$reg" ]]    || die "--registry <host:5000> required"
  [[ -n "$agekey" && -f "$agekey" ]] || die "--age-key <fleet.agekey> required (the fleet age PRIVATE key)"
  [[ -n "$ctag" ]]   || die "--config-tag <tag> required (the keos-config artifact tag, e.g. 1.1.0-edge)"
  local oci_insecure="false"; [[ "$plain" -eq 1 ]] && oci_insecure="true"
  local gd="$SCRIPT_DIR/../deploy/gitops/flux"
  [[ -d "$gd" ]] || die "deploy/gitops/flux not found next to keosctl"

  heading "Bootstrapping Flux GitOps from ${reg}"
  info "Installing Flux controllers (${comp}) — images from ${reg}/fluxcd"
  flux install --components="$comp" --registry="${reg}/fluxcd" || die "flux install failed"

  info "Installing the fleet age key (sops-age secret in flux-system)"
  kubectl create secret generic sops-age -n flux-system \
    --from-file=age.agekey="$agekey" --dry-run=client -o yaml | kubectl apply -f - \
    || die "could not create sops-age secret"

  info "Applying root OCIRepository + Kustomization → oci://${reg}/keos-config:${ctag}"
  REGISTRY="$reg" CONFIG_TAG="$ctag" OCI_INSECURE="$oci_insecure" \
    envsubst '${REGISTRY} ${CONFIG_TAG} ${OCI_INSECURE}' < "$gd/ocirepository-config.yaml" | kubectl apply -f - \
    || die "applying OCIRepository failed"
  envsubst < "$gd/kustomization.yaml" | kubectl apply -f - || die "applying Kustomization failed"

  ok "GitOps bootstrap complete — Flux now reconciles Keos from ${reg}/keos-config:${ctag}"
  note "watch:  keosctl gitops status     force a pull:  keosctl gitops sync"
}

# Probe the live cluster (like install-edge does) and emit a starter
# values-<env>.yaml the operator reviews + feeds to `release.sh config`.
_gitops_render() {
  local reg="" out="" node="" env_name="${ENV:-edge}"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --registry) reg="$2"; shift 2 ;;
      --out)      out="$2"; shift 2 ;;
      --node)     node="$2"; shift 2 ;;
      --env)      env_name="$2"; shift 2 ;;
      *) die "unrecognized argument '$1' — run this command with -h/--help to see valid options." ;;
    esac
  done
  [[ -n "$reg" ]] || die "--registry <host:5000> required"
  command -v envsubst >/dev/null || die "envsubst required (gettext)"
  local ex="$SCRIPT_DIR/../deploy/gitops/config/values-edge.example.yaml"
  [[ -f "$ex" ]] || die "example values not found at $ex"
  out="${out:-values-${env_name}.yaml}"

  # Probe: GPU node (first with nvidia.com/gpu), else first node.
  local gpu_node gpu="false"
  gpu_node="$(kc_cluster get nodes -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.status.allocatable.nvidia\.com/gpu}{"\n"}{end}' 2>/dev/null | awk -F'\t' '$2>0{print $1; exit}')"
  [[ -n "$gpu_node" ]] && gpu="true"
  node="${node:-${gpu_node:-$(kc_cluster get nodes -o jsonpath='{.items[0].metadata.name}' 2>/dev/null)}}"

  REGISTRY="$reg" NODE_NAME="${node:-CHANGEME}" envsubst '${REGISTRY} ${NODE_NAME}' < "$ex" > "$out"
  if [[ "$gpu" == "true" ]]; then
    # flip ollama.gpu.enabled true (best-effort sed on the rendered block)
    sed -i 's/^\(  gpu:\)/\1/; s/^\(    enabled: \)false/\1true/' "$out" 2>/dev/null || true
  fi
  ok "wrote $out  (node=${node:-?} gpu=${gpu})"
  note "Review: security tier (falco/tetragon), containerd socket (Talos differs),"
  note "  agent.defaultMode, GPU. Then push it:"
  note "  KEOS_AGE_RECIPIENT=age1... ENV=${env_name} VALUES_FILE=$out \\"
  note "    REGISTRY=${reg} keosctl release config"
}

# ─── Workstation wrappers (Phase 24) ─────────────────────────────────────────
# keosctl is the single operator entry point — these front the build/release
# helpers so nobody has to remember a raw script path or its env contract.
# Each requires REGISTRY in the environment (the private fleet registry).

# Resolve an internal helper script or fail with an actionable message.
_helper() {
  local name="$1"
  if [[ -r "$SCRIPT_DIR/$name" ]]; then echo "$SCRIPT_DIR/$name"; return 0; fi
  die "internal helper '$name' not found next to keosctl ($SCRIPT_DIR).
   keosctl must run from a full repo checkout for build/release commands.
   Fix: re-clone the repo, or run from sre-agent/scripts/. (try: keosctl version)"
}

cmd_release() {
  _check_help release "$@"
  [[ $# -gt 0 ]] || die "usage: keosctl release {build|mirror|chart|config|verify|all}
   Populate the private fleet registry (images + chart + GitOps config).
   Needs REGISTRY in the environment, e.g.:  REGISTRY=registry.fleet.local:5000 keosctl release all
   try: keosctl release --help"
  [[ -n "${REGISTRY:-}" || "$1" == "images-list" ]] || die "REGISTRY is required.
   Set the private registry first:  REGISTRY=registry.fleet.local:5000 keosctl release $1
   (plain-HTTP/self-signed lab registry → add --insecure)"
  exec bash "$(_helper release.sh)" "$@"
}

cmd_bundle() {
  _check_help bundle "$@"
  local action="${1:-create}"; shift || true
  case "$action" in
    create) exec bash "$(_helper build-airgap-bundle.sh)" "$@" ;;
    *) die "usage: keosctl bundle create [flags]
   Builds a single offline tarball (images + chart + models) for an air-gapped site.
   try: keosctl bundle --help" ;;
  esac
}

cmd_falco_probe() {
  _check_help falco-probe "$@"
  local action="${1:-build}"; shift || true
  case "$action" in
    build) exec bash "$(_helper build-falco-probe.sh)" "$@" ;;
    *) die "usage: keosctl falco-probe build [--insecure]
   Compiles the Falco eBPF probe for THIS node's kernel (BTF-less kernels, e.g. Jetson L4T)
   and pushes it to the registry. Run on the target node with sudo + REGISTRY set.
   try: keosctl falco-probe --help" ;;
  esac
}

main() {
  parse_global "$@"
  set -- "${REMAINING[@]:-}"
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    install)         cmd_install "$@" ;;
    gitops)          cmd_gitops "$@" ;;
    release)         cmd_release "$@" ;;
    bundle)          cmd_bundle "$@" ;;
    falco-probe)     cmd_falco_probe "$@" ;;
    uninstall)       cmd_uninstall "$@" ;;
    status)          cmd_status "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    preflight)       cmd_preflight "$@" ;;
    gpu-setup)       cmd_gpu_setup "$@" ;;
    mode)            cmd_mode "$@" ;;
    logs)            cmd_logs "$@" ;;
    ui)              cmd_ui "$@" ;;
    token)           cmd_token "$@" ;;
    seed)            cmd_seed "$@" ;;
    models)          cmd_models "$@" ;;
    events)          cmd_events "$@" ;;
    incidents)       cmd_incidents "$@" ;;
    usecases)        cmd_usecases "$@" ;;
    run)             cmd_run "$@" ;;
    restart)         cmd_restart "$@" ;;
    shell|exec)      cmd_shell "$@" ;;
    describe)        cmd_describe "$@" ;;
    port-forward|pf) cmd_portforward "$@" ;;
    upgrade)         cmd_upgrade "$@" ;;
    audit)           cmd_audit "$@" ;;
    completion)      cmd_completion "$@" ;;
    context)         cmd_context "$@" ;;
    version|--version|-v) cmd_version "$@" ;;
    link)            cmd_link "$@" ;;
    api)             cmd_api "$@" ;;
    backup)          cmd_backup "$@" ;;
    restore)         cmd_restore "$@" ;;
    diag|support-bundle) cmd_diag "$@" ;;
    calibration|cal) cmd_calibration "$@" ;;
    config)          cmd_config "$@" ;;
    chaos)           cmd_chaos "$@" ;;
    top)             cmd_top "$@" ;;
    update)          cmd_update "$@" ;;
    deps|dependencies) cmd_deps "$@" ;;
    images|image)    cmd_images "$@" ;;
    values)          cmd_values "$@" ;;
    policy)          cmd_policy "$@" ;;
    runbooks|runbook) cmd_runbooks "$@" ;;
    quarantine)      cmd_quarantine "$@" ;;
    bus|nats)        cmd_bus "$@" ;;
    help|--help|-h|"") cmd_help ;;
    *)
      printf "${C_RED}${CROSS}${C_RST} unknown command '%s'\n\n" "$cmd"
      printf "Did you mean one of these?\n"
      for c in install gitops release bundle falco-probe uninstall status doctor preflight gpu-setup mode logs ui token seed models events incidents usecases run restart shell describe port-forward upgrade audit completion context version link api backup restore diag calibration config chaos top update deps images values policy runbooks quarantine bus help; do
        # Cheap fuzzy: print commands that share a prefix or contain the typo.
        if [[ "$c" == "$cmd"* || "$c" == *"$cmd"* ]]; then
          printf "  ${C_CYAN}%s${C_RST}\n" "$c"
        fi
      done
      printf "\nRun ${C_CYAN}keosctl help${C_RST} for the full command list.\n"
      exit 1
      ;;
  esac
}

main "$@"
