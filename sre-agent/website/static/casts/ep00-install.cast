[10.965654, "o", "\u001b[H\u001b[2J\u001b[3J"]
[10.965756, "o", "\r\n\u001b[1m\u001b[36m"]
[10.975715, "o", "       ██╗  ██╗███████╗ ██████╗ ███████╗\r\n       ██║ ██╔╝██╔════╝██╔═══██╗██╔════╝\r\n       █████╔╝ █████╗  ██║   ██║███████╗\r\n       ██╔═██╗ ██╔══╝  ██║   ██║╚════██║\r\n       ██║  ██╗███████╗╚██████╔╝███████║\r\n       ╚═╝  ╚═╝╚══════╝ ╚═════╝ ╚══════╝\r\n"]
[10.975825, "o", "\u001b[0m\r\n       \u001b[1mThe Autonomous SRE Agent for Edge Kubernetes\u001b[0m\r\n"]
[10.975844, "o", "       \u001b[2mby Pocteo Platform · v1.0.1\u001b[0m\r\n\r\n"]
[10.975856, "o", "\u001b[90m────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[10.976022, "o", "  \u001b[2mThis wizard installs Keos on a Kubernetes cluster.\u001b[0m\r\n  \u001b[2mEstimated time: 5–15 min on a typical install (mostly LLM model download).\u001b[0m\r\n\u001b[90m────────────────────────────────────────────────────────────────\u001b[0m\r\n  Press \u001b[1m[enter]\u001b[0m to begin, or \u001b[1m[Ctrl-C]\u001b[0m to quit.\r\n"]
[13.960285, "o", "\r\n\u001b[1m\u001b[34mSTEP 1/6 \u001b[0m\u001b[1m· Prerequisites\u001b[0m\r\n\u001b[90m────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[14.272906, "o", "  \u001b[32m✓\u001b[0m kubectl         \u001b[2mv1.34.1\u001b[0m\r\n"]
[15.730671, "o", "  \u001b[32m✓\u001b[0m helm            \u001b[2mv4.2.0+g0646808\u001b[0m\r\n"]
[15.957782, "o", "  \u001b[32m✓\u001b[0m docker          \u001b[2m27.5.1\u001b[0m\r\n"]
[15.962595, "o", "  \u001b[32m✓\u001b[0m openssl         \u001b[2m3.0.13\u001b[0m\r\n"]
[15.964766, "o", "  \u001b[32m✓\u001b[0m python3         \u001b[2m3.12.3\u001b[0m\r\n"]
[15.989809, "o", "  \u001b[32m✓\u001b[0m curl            \u001b[2m8.5.0\u001b[0m\r\n\r\n  \u001b[2mAll prerequisites detected.\u001b[0m\r\n"]
[15.989912, "o", "\r\n  \u001b[2mPress [enter] to continue…\u001b[0m"]
[17.961216, "o", "\r\n\u001b[1m\u001b[34mSTEP 2/6 \u001b[0m\u001b[1m· Cluster\u001b[0m\r\n\u001b[90m────────────────────────────────────────────────────────────────\u001b[0m\r\n  Detected kubectl contexts:\r\n\r\n"]
[18.52788, "o", "    \u001b[2m1)\u001b[0m admin@edge-probe                           \u001b[31m✗ unreachable\u001b[0m\r\n"]
[18.71158, "o", "    \u001b[2m2)\u001b[0m admin@keos-talos-1                         \u001b[31m✗ unreachable\u001b[0m\r\n"]
[18.886624, "o", "    \u001b[2m3)\u001b[0m admin@keos-talos-2                         \u001b[31m✗ unreachable\u001b[0m\r\n"]
[19.080212, "o", "    \u001b[2m4)\u001b[0m kind-kubewarroom                         \u001b[32m[current]\u001b[0m  \u001b[32m✓\u001b[0m \u001b[2mnodes=1\u001b[0m\r\n"]
[19.266616, "o", "    \u001b[2m5)\u001b[0m vcluster-platform                          \u001b[31m✗ unreachable\u001b[0m\r\n\r\n"]
[19.266945, "o", "  \u001b[1mUse context # (or path to kubeconfig)\u001b[0m \u001b[2m[4]\u001b[0m "]
[23.96251, "o", "  \u001b[2mSelected: kind-kubewarroom\u001b[0m\r\n\r\n\u001b[1m\u001b[34mSTEP 3/6 \u001b[0m\u001b[1m· Discovered cluster facts\u001b[0m\r\n"]
[23.962627, "o", "\u001b[90m────────────────────────────────────────────────────────────────\u001b[0m\r\n"]
[25.54662, "o", "  \u001b[34m•\u001b[0m Kubernetes      \u001b[2mv1.31.2  ·  1 node(s)\u001b[0m\r\n  \u001b[34m•\u001b[0m OS image        \u001b[2mDebian GNU/Linux 12 (bookworm)\u001b[0m\r\n  \u001b[34m•\u001b[0m Runtime         \u001b[2mcontainerd://1.7.18\u001b[0m\r\n"]
[25.546714, "o", "  \u001b[34m•\u001b[0m Distro          \u001b[2mkubeadm\u001b[0m\r\n  \u001b[34m•\u001b[0m Target node     \u001b[2mkubewarroom-control-plane\u001b[0m\r\n  \u001b[34m•\u001b[0m Capacity        \u001b[2m20 vCPU · 32726064Ki\u001b[0m\r\n"]
[25.546772, "o", "  \u001b[34m•\u001b[0m GPU             not detected — CPU mode\r\n\r\n"]
[25.5477, "o", "  \u001b[1mContinue with these defaults?\u001b[0m \u001b[2m[Y/n]\u001b[0m "]
[29.963262, "o", "\r\n\u001b[1m\u001b[34mSTEP 4/6 \u001b[0m\u001b[1m· LLM model\u001b[0m\r\n\u001b[90m────────────────────────────────────────────────────────────────\u001b[0m\r\n  Pick the chat model sized for your hardware:\r\n\r\n"]
[29.963737, "o", "    \u001b[2m1)\u001b[0m \u001b[1mqwen2.5:1.5b-instruct-q4_K_M\u001b[0m   \u001b[2m~0.9 GB  · ~2 s/call Jetson · low memory\u001b[0m\r\n    \u001b[36m\u001b[1m2)\u001b[0m \u001b[1mqwen2.5:3b-instruct-q4_K_M\u001b[0m    \u001b[2m~1.9 GB  · ~5 s/call Jetson · \u001b[32mrecommended\u001b[0m \u001b[32m✓ default\u001b[0m\r\n"]
[29.963825, "o", "    \u001b[2m3)\u001b[0m \u001b[1mqwen2.5:7b-instruct-q4_K_M\u001b[0m    \u001b[2m~4.5 GB  · ~15 s/call Jetson · highest quality\u001b[0m\r\n    \u001b[2m4)\u001b[0m \u001b[1mllama3.2:3b-instruct-q4_K_M\u001b[0m   \u001b[2m~2.0 GB  · ~5 s/call Jetson · alternative\u001b[0m\r\n\r\n"]
[29.963899, "o", "  \u001b[1mSelect model #\u001b[0m \u001b[2m[2]\u001b[0m "]
[35.9644, "o", "  \u001b[2mSelected: qwen2.5:3b-instruct-q4_K_M\u001b[0m\r\n  \u001b[2mEmbedding model: nomic-embed-text (270 MB — same for every install)\u001b[0m\r\n\r\n\u001b[1m\u001b[34mSTEP 5/6 \u001b[0m\u001b[1m· Image source\u001b[0m\r\n"]
[35.96445, "o", "\u001b[90m────────────────────────────────────────────────────────────────\u001b[0m\r\n  The Keos container images live at ghcr.io/pocteo-platform. We'll\r\n  probe whether they're anonymously pullable from this machine.\r\n\r\n"]
[36.297382, "o", "  \u001b[2mImages at ghcr.io/pocteo-platform/keos-*\u001b[0m   \u001b[33m⚠ private (403)\u001b[0m\r\n"]
[36.297491, "o", "  \u001b[2mChart at ghcr.io/pocteo-platform/charts/pocteo\u001b[0m  \u001b[33m⚠ private (403)\u001b[0m\r\n\r\n"]
[36.298038, "o", "    \u001b[2m1)\u001b[0m \u001b[1mUse public images\u001b[0m                \u001b[2mfastest — needs the GHCR packages to be public\u001b[0m\r\n    \u001b[36m\u001b[1m2)\u001b[0m \u001b[1mBuild locally\u001b[0m                    \u001b[2mdocker build the 3 images + import into the cluster (~5 min cold)\u001b[0m \u001b[32m✓ default\u001b[0m\r\n"]
[36.29815, "o", "    \u001b[2m3)\u001b[0m \u001b[1mAir-gapped install\u001b[0m               \u001b[2muse a mirror registry + the embedded chart\u001b[0m\r\n\r\n  \u001b[1mChoose image source #\u001b[0m \u001b[2m[2]\u001b[0m "]
[42.965342, "o", "  \u001b[2mSelected: local-build\u001b[0m\r\n\r\n\u001b[1m\u001b[34mSTEP 6/6 \u001b[0m\u001b[1m· Agent default mode\u001b[0m\r\n"]
[42.965435, "o", "\u001b[90m────────────────────────────────────────────────────────────────\u001b[0m\r\n  Pick what the agent does when an incident lands:\r\n\r\n"]
[42.965877, "o", "    \u001b[36m\u001b[1m1)\u001b[0m \u001b[1mobserve-only\u001b[0m     \u001b[2mdry-run · agent diagnoses but does not mutate the cluster\u001b[0m \u001b[32m✓ safe default\u001b[0m \u001b[32m✓ default\u001b[0m\r\n    \u001b[2m2)\u001b[0m \u001b[1mactive\u001b[0m           \u001b[33m⚠\u001b[0m \u001b[2magent mutates after policy gate — real heals\u001b[0m\r\n"]
[42.966053, "o", "    \u001b[2m3)\u001b[0m \u001b[1mfrozen\u001b[0m           \u001b[2mno-op · for maintenance windows\u001b[0m\r\n\r\n"]
[42.966155, "o", "  \u001b[1mChoose default mode #\u001b[0m \u001b[2m[1]\u001b[0m "]
[47.966383, "o", "  \u001b[2mSelected: observe-only\u001b[0m\r\n"]
[47.96655, "o", "\r\n\u001b[1m\u001b[36mReview · ready to install\u001b[0m\r\n\u001b[90m────────────────────────────────────────────────────────────────\u001b[0m\r\n  \u001b[34m•\u001b[0m Cluster         \u001b[2mkind-kubewarroom · distro=kubeadm\u001b[0m\r\n  \u001b[34m•\u001b[0m Target node     \u001b[2mkubewarroom-control-plane\u001b[0m\r\n  \u001b[34m•\u001b[0m GPU mode        \u001b[2mauto\u001b[0m\r\n"]
[47.966649, "o", "  \u001b[34m•\u001b[0m Image source    \u001b[2mlocal-build\u001b[0m\r\n  \u001b[34m•\u001b[0m Chat model      \u001b[2mqwen2.5:3b-instruct-q4_K_M\u001b[0m\r\n  \u001b[34m•\u001b[0m Embed model     \u001b[2mnomic-embed-text\u001b[0m\r\n  \u001b[34m•\u001b[0m Default mode    \u001b[2mobserve-only\u001b[0m\r\n  \u001b[34m•\u001b[0m Namespace       \u001b[2mkeos\u001b[0m\r\n  \u001b[34m•\u001b[0m Helm release    \u001b[2mkeos\u001b[0m\r\n\r\n"]
[47.967605, "o", "  \u001b[1mProceed with install?\u001b[0m \u001b[2m[Y/n]\u001b[0m "]
[53.967267, "o", "\r\n  \u001b[2mAborted by operator. Nothing changed.\u001b[0m\r\n"]
[54.970299, "o", "\r\n\u001b[90m# Answer Y instead and ~5 minutes later: 13 pods, models pulled, corpus seeded.\u001b[0m\r\n"]
[56.171816, "o", "\r\n\u001b[90m# Then everything is keosctl — see Episode 1.\u001b[0m\r\n"]
[57.373515, "o", "\r\n\u001b[90m# docs: pocteo-platform.github.io/keos  ·  keosctl help\u001b[0m\r\n\r\n"]
